<%- |
  Array[String] $rules,
| -%>
#
# Nest CLI Reset Rsync Filter Rules
#
# These rules are sourced by rsync(1) in the `nest reset` sync step to
# prevent files from being updated or deleted.
#
# Managed by Puppet
#

# Global rules
P /boot/**
- /etc/hostid
# Keep the host identity across generic Stage 3 payloads. The first boot needs
# it for Host= network matches and stable DHCP identity before Puppet can run.
- /etc/hostname
- /etc/machine-id
- /etc/mtab
- /etc/printcap
- /etc/resolv.conf
- /etc/containers/storage.conf
- /etc/cups/
- /etc/dracut.conf.d/
- /etc/firewalld/
- /etc/kernel/cmdline
- /etc/nest/
- /etc/portage/make.conf
- /etc/zfs/zpool.cache
- /home/
- /root/
- /srv/
P /var/lib/bluetooth/**
P /var/lib/misc/dnsmasq.leases
# Shared host transaction state must never be copied or deleted by legacy reset.
- /var/lib/nest/updates/***
# Immutable generations are host-local mounts, never part of the BE payload.
- /var/lib/nest/generations/***
P /var/log/**
P /var/tmp/**

# Kernel (updates managed in another step)
- /usr/lib/modules/
- /usr/src/linux/

# Kubernetes
- /etc/kubernetes/
P /opt/cni/**
- /var/lib/calico/
- /var/lib/cni/
- /var/lib/crio/
- /var/lib/etcd/
- /var/lib/kubelet/
- /var/lib/rook/
<% unless $rules.empty { -%>

# Host-specific rules
<% $rules.each |$rule| { -%>
<%= $rule %>
<% } -%>
<% } -%>
