{
  "description": "Retain exact reboot continuity after reopening an existing pre-reboot supervisor receipt; never submit or accept",
  "input_method": "stdin",
  "supports_noop": false,
  "files": [
    "nest/tasks/retain_update_report.py",
    "nest/tasks/retain_update_reboot.py"
  ],
  "parameters": {
    "action": {
      "type": "Enum['check', 'retain']"
    },
    "transaction": {
      "type": "Pattern[/\\A[A-Za-z0-9][A-Za-z0-9_-]{0,63}\\z/]"
    },
    "release": {
      "type": "Pattern[/\\Asha256:[0-9a-f]{64}\\z/]"
    },
    "hostname": {
      "type": "String[1]"
    },
    "output_dir": {
      "type": "Stdlib::Absolutepath"
    },
    "admission": {
      "type": "Hash",
      "description": "Exact retained original-boot reboot-plan receipt, reopened before host contact"
    },
    "report": {
      "type": "Optional[String[1]]",
      "description": "Native read-only status stdout"
    }
  }
}
