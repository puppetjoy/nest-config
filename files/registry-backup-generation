#!/bin/sh

set -eu

backup_root=$1
shift
[ "${1:-}" = '--' ]
shift
[ "$#" -gt 0 ]

generation_id="$(date -u +%Y%m%dT%H%M%S)-$$"
staging_root="${backup_root}/.staging"
staging="${staging_root}/${generation_id}"
generations="${backup_root}/generations"
generation="${generations}/${generation_id}"
current_tmp="${backup_root}/.current-${generation_id}"
legacy_retirement="${backup_root}/.legacy-retired-${generation_id}"
migrating_legacy=false
previous_generation=

install -d -m 0700 "$staging_root" "$generations"
for stale_staging in "$staging_root"/*; do
  [ -e "$stale_staging" ] || [ -L "$stale_staging" ] || continue
  rm -rf "$stale_staging"
done
install -d -m 0700 "$staging"
install -d -m 0700 "$staging/data"
cleanup() {
  rm -rf "$staging" "$current_tmp" "$legacy_retirement"
}
trap cleanup EXIT HUP INT TERM

# Seed the new generation with block clones from the last completed payload so
# s3cmd only has to transfer changes.  A brand-new empty generation would turn
# every backup into a full multi-terabyte download and cannot meet the bounded
# job deadline.  The first run block-clones the legacy in-place payload instead.
if [ -L "$backup_root/current" ]; then
  current_generation="$(readlink -f "$backup_root/current")"
  current_name="${current_generation#"${generations}/"}"
  case "$current_generation" in
    "$generations"/*) ;;
    *)
      printf '%s\n' 'registry backup current pointer is invalid' >&2
      exit 1
      ;;
  esac
  case "$current_name" in
    ''|.|..|*/*)
      printf '%s\n' 'registry backup current pointer is invalid' >&2
      exit 1
      ;;
  esac
  [ -f "$current_generation/.complete" ]
  [ -d "$current_generation/data" ]
  previous_generation=$current_generation
  for stale_retirement in "$backup_root"/.legacy-retired-*; do
    [ -e "$stale_retirement" ] || [ -L "$stale_retirement" ] || continue
    rm -rf "$stale_retirement"
  done
  cp -a --reflink=always "$current_generation/data/." "$staging/data/"
elif [ -e "$backup_root/current" ]; then
  printf '%s\n' 'registry backup current pointer is not a symlink' >&2
  exit 1
else
  migrating_legacy=true
  for legacy_path in "$backup_root"/* "$backup_root"/.[!.]* "$backup_root"/..?*; do
    [ -e "$legacy_path" ] || [ -L "$legacy_path" ] || continue
    case "${legacy_path##*/}" in
      .staging|generations|current|.current-*) continue ;;
    esac
    cp -a --reflink=always "$legacy_path" "$staging/data/"
  done
fi

"$@" "$staging/data/"
printf '%s\n' "$generation_id" > "$staging/.complete"
mv "$staging" "$generation"
ln -s "generations/${generation_id}" "$current_tmp"
mv -Tf "$current_tmp" "$backup_root/current"

# The first completed generation supersedes the legacy in-place payload.  Only
# retire the same allowlisted top-level payload names after current has been
# atomically published, so a failed initial sync leaves the legacy tree intact.
# If the host is interrupted while moving these entries, current is already a
# complete generation and the next run seeds from it rather than from legacy.
if [ "$migrating_legacy" = true ]; then
  install -d -m 0700 "$legacy_retirement"
  for legacy_path in "$backup_root"/* "$backup_root"/.[!.]* "$backup_root"/..?*; do
    [ -e "$legacy_path" ] || [ -L "$legacy_path" ] || continue
    case "${legacy_path##*/}" in
      .staging|generations|current|.current-*|.legacy-retired-*) continue ;;
    esac
    mv "$legacy_path" "$legacy_retirement/"
  done
  rm -rf "$legacy_retirement"
fi

# Keep the new current generation and the exact generation that was current
# when this run began. Do not infer chronology from names: multiple manual runs
# can publish in one second and variable-width process IDs do not sort by time.
for candidate in "$generations"/*; do
  [ -e "$candidate" ] || [ -L "$candidate" ] || continue
  if [ "$candidate" != "$generation" ] && [ "$candidate" != "$previous_generation" ]; then
    rm -rf "$candidate"
  fi
done

trap - EXIT HUP INT TERM
