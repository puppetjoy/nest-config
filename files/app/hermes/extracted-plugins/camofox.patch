diff --git a/tests/test_nest_viewport.py b/tests/test_nest_viewport.py
new file mode 100644
index 0000000..43914fa
--- /dev/null
+++ b/tests/test_nest_viewport.py
@@ -0,0 +1,54 @@
+"""Nest regressions: configured desktop size, navigation order, viewport-only pixels/metadata."""
+import io
+import json
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from PIL import Image
+import pytest
+
+from camofox_plugin import camofox_client as client
+from camofox_plugin import camofox_tools as tools
+
+
+@pytest.mark.parametrize('config,expected', [
+    ({}, {'width': 1365, 'height': 768}),
+    ({'viewport': {'width': 1920, 'height': 1080}}, {'width': 1920, 'height': 1080}),
+    ({'viewport': {'width': 20, 'height': 'bad'}}, {'width': 1365, 'height': 768}),
+])
+def test_viewport_defaults_and_config(config, expected):
+    assert client.configured_viewport(config) == expected
+
+
+def test_config_url_fallback(monkeypatch, write_config):
+    monkeypatch.delenv('CAMOFOX_URL', raising=False)
+    write_config('browser:\n  camofox:\n    url: http://camofox.invalid/\n')
+    assert client.get_camofox_url() == 'http://camofox.invalid'
+
+
+def test_blank_tab_then_navigation_with_configured_desktop(camofox, write_config):
+    write_config('browser:\n  camofox:\n    viewport: {width: 1920, height: 1080}\n')
+    assert json.loads(tools.browser_navigate('https://example.org', task_id='nest'))['success']
+    calls = [r for r in camofox.requests if r['method'] == 'POST']
+    assert calls[0]['path'] == '/tabs'
+    assert 'url' not in calls[0]['body']
+    assert calls[0]['body']['viewport'] == {'width': 1920, 'height': 1080}
+    assert calls[1]['path'].endswith('/navigate')
+    assert calls[1]['body']['url'] == 'https://example.org'
+
+
+@pytest.mark.parametrize('viewport,check', [((640, 480), 'primary_capture_matches_viewport'),
+                                          ((1365, 768), 'browser_viewport_mismatch')])
+def test_viewport_screenshot_metadata(viewport, check):
+    image = io.BytesIO()
+    Image.new('RGB', (640, 480)).save(image, format='PNG')
+    session = {'tab_id': 'tab', 'user_id': 'user'}
+    with patch.object(client, 'get_raw', return_value=SimpleNamespace(content=image.getvalue())) as get_raw, \
+            patch.object(client, 'post', return_value={'result': json.dumps(dict(zip(('innerWidth', 'innerHeight'), viewport)))}):
+        content, metadata = tools.capture_viewport_screenshot(session)
+    assert content == image.getvalue()
+    assert get_raw.call_args.kwargs['params'] == {'userId': 'user', 'fullPage': 'false'}
+    assert metadata['final_dimensions'] == {'width': 640, 'height': 480}
+    assert metadata['viewport_metrics'] == dict(zip(('innerWidth', 'innerHeight'), viewport))
+    assert metadata['dimension_check'] == check
+    assert metadata['fallback_used'] is False
