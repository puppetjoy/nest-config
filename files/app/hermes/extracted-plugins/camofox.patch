+def configured_viewport(config: dict[str, Any]) -> dict[str, int]:
+    """Keep a usable desktop viewport even when configuration is malformed."""
+    viewport = config.get("viewport")
+    viewport = viewport if isinstance(viewport, dict) else {}
+    result = {}
+    for key, default, minimum in (("width", 1365, 320), ("height", 768, 240)):
+        try:
+            value = int(viewport.get(key, default))
+        except (ValueError, TypeError):
+            value = default
+        result[key] = value if value >= minimum else default
+    return result
+
