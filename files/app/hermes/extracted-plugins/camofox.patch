+def capture_viewport_screenshot(session: dict[str, Any]) -> tuple[bytes, dict[str, Any]]:
+    """Capture only the viewport and disclose the actual image and browser dimensions."""
+    response = client.get_raw(client.tab_path(session, "screenshot"),
+                              params={**client.user_params(session), "fullPage": "false"})
+    metadata: dict[str, Any] = {"primary_capture_params": {"fullPage": "false"}, "fallback_used": False}
+    try:
+        from PIL import Image
+        with Image.open(io.BytesIO(response.content)) as image:
+            width, height = image.size
+        metadata["primary_capture_dimensions"] = {"width": width, "height": height}
+        metadata["final_dimensions"] = metadata["primary_capture_dimensions"]
+        result = client.post(client.tab_path(session, "evaluate"), {
+            "userId": session["user_id"],
+            "expression": "JSON.stringify({innerWidth:window.innerWidth,innerHeight:window.innerHeight})",
+        })
+        metrics = result.get("result", result.get("value", result))
+        if isinstance(metrics, str):
+            metrics = json.loads(metrics)
+        if isinstance(metrics, dict):
+            metadata["viewport_metrics"] = metrics
+            expected = {"width": int(metrics.get("innerWidth", 0)), "height": int(metrics.get("innerHeight", 0))}
+            if expected["width"] > 0 and expected["height"] > 0:
+                if expected == metadata["final_dimensions"]:
+                    metadata["dimension_check"] = "primary_capture_matches_viewport"
+                else:
+                    metadata["dimension_check"] = "browser_viewport_mismatch"
+                    metadata["expected_viewport_dimensions"] = expected
+    except Exception as exc:
+        metadata["dimension_check_error"] = str(exc)
+    return response.content, metadata
