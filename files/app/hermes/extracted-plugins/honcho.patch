+def _clamp01(value: Any) -> Optional[float]:
+    if value is None or isinstance(value, bool):
+        return None
+    try:
+        f = float(value)
+    except (TypeError, ValueError):
+        return None
+    if not math.isfinite(f):
+        return None
+    if f > 1.0 and f <= 100.0:
+        f = f / 100.0
+    return min(1.0, max(0.0, f))
+
+
+def _extract_probe_values(evidence: Mapping[str, Any]) -> Dict[str, Any]:
+    probes = evidence.get("probes")
+    if isinstance(probes, Mapping):
+        return dict(probes)
+    return {k: evidence.get(k) for k in PROBE_DEFINITIONS if k in evidence}
+
+
+def _number(data: Mapping[str, Any], *keys: str) -> Optional[float]:
+    for key in keys:
+        value = data.get(key)
+        if value is None or isinstance(value, bool):
+            continue
+        try:
+            numeric = float(value)
+        except (TypeError, ValueError):
+            continue
+        if math.isfinite(numeric):
+            return numeric
+    return None
+
+
+def _count(data: Mapping[str, Any], *keys: str) -> Optional[float]:
+    value = _number(data, *keys)
+    if value is None or value < 0:
+        return None
+    return value
+
+
+def _ratio(numerator: Optional[float], denominator: Optional[float]) -> Optional[float]:
+    if numerator is None or denominator is None or denominator <= 0:
+        return None
+    return min(1.0, max(0.0, numerator / denominator))
+
+
+def _mean(values: Iterable[Optional[float]]) -> Optional[float]:
+    usable = [float(v) for v in values if v is not None and math.isfinite(float(v))]
+    if not usable:
+        return None
+    return sum(usable) / len(usable)
+
+
+def _bool_score(data: Mapping[str, Any], *keys: str) -> Optional[float]:
+    for key in keys:
+        value = data.get(key)
+        if isinstance(value, bool):
+            return 1.0 if value else 0.0
+        if isinstance(value, (int, float)) and not isinstance(value, bool) and value in (0, 1):
+            return float(value)
+    return None
+
+
+def _has_any_key(data: Mapping[str, Any], keys: Iterable[str]) -> bool:
+    return any(key in data for key in keys)
+
+
+def _queue_evidence_state(data: Mapping[str, Any]) -> Optional[bool]:
+    """Return queue evidence state: True=ok, False=failed/missing, None=unused.
+
+    The hourly probe accepts aggregate counts from several sources.  Queue and
+    CNPG-derived values are especially dangerous to default to zero after a SQL
+    failure: zero pending rows is healthy only when the query itself succeeded.
+    When a caller provides queue-derived fields, require an explicit ok marker;
+    otherwise treat the source as unknown/missing so downstream probes are
+    omitted instead of recording perfect health from fallback zeros.
+    """
+
+    for key in _QUEUE_EVIDENCE_MISSING_KEYS:
+        if _bool_score(data, key) == 1.0:
+            return False
+    for key in _QUEUE_EVIDENCE_OK_KEYS:
+        score = _bool_score(data, key)
+        if score == 0.0:
+            return False
+        if score == 1.0:
+            return True
+    if _has_any_key(data, _QUEUE_DERIVED_KEYS):
+        return False
+    return None
+
+
+def _zero_is_good_score(data: Mapping[str, Any], *keys: str, tolerance: float = 0.0) -> Optional[float]:
+    value = _count(data, *keys)
+    if value is None:
+        return None
+    if tolerance <= 0:
+        return 1.0 if value <= 0 else 0.0
+    return max(0.0, 1.0 - min(1.0, value / tolerance))
+
+
+def _status_ok_score(data: Mapping[str, Any], *keys: str, ok_values: Iterable[float]) -> Optional[float]:
+    value = _number(data, *keys)
+    if value is None:
+        return None
+    return 1.0 if value in set(float(v) for v in ok_values) else 0.0
+
+
+def _any_positive_count(data: Mapping[str, Any], *keys: str) -> bool:
+    for key in keys:
+        value = _count(data, key)
+        if value is not None and value > 0:
+            return True
+    return False
+
+
+def _sum_counts(data: Mapping[str, Any], *keys: str) -> Optional[float]:
+    values = [_count(data, key) for key in keys]
+    usable = [float(value) for value in values if value is not None]
+    if not usable:
+        return None
+    return sum(usable)
+
+
+def _sanitized_aggregate_values(evidence: Mapping[str, Any]) -> Dict[str, Any]:
+    aggregates = evidence.get("aggregates")
+    if not isinstance(aggregates, Mapping):
+        aggregates = evidence
+    safe: Dict[str, Any] = {"probe_runner": SAFE_PROBE_RUNNER_ID}
+    for key, value in aggregates.items():
+        name = str(key)
+        name_parts = set(re.split(r"[^a-z0-9]+", name.lower()))
+        if name.lower() in _UNSAFE_AGGREGATE_VALUE_NAMES:
+            continue
+        if isinstance(value, bool):
+            if name_parts & _UNSAFE_AGGREGATE_SCALAR_PARTS:
+                continue
+            safe[name] = value
+        elif isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(float(value)):
+            if name_parts & _UNSAFE_AGGREGATE_SCALAR_PARTS:
+                continue
+            safe[name] = value
+        elif (
+            isinstance(value, str)
+            and not (name_parts & _UNSAFE_AGGREGATE_VALUE_NAMES)
+            and (name.endswith("_label") or name.endswith("_id") or name in {"source", "window"})
+            and _SAFE_LABEL_RE.fullmatch(value)
+        ):
+            safe[name] = value
+    return safe
+
+
+def _safe_probe_label(value: Any) -> Optional[str]:
+    if not isinstance(value, str):
+        return None
+    label = value.strip().lower()
+    if not _SAFE_LABEL_RE.fullmatch(label):
+        return None
+    return label
+
+
+def _iter_safe_labeled_probe_results(evidence: Mapping[str, Any]) -> Iterable[Mapping[str, str]]:
+    """Yield fixed-label probe result rows without retaining raw content.
+
+    Hourly cron runs can summarize native Honcho tool outcomes as rows such as
+    {"query_label": "recent_profile", "recall_label": "useful"}. Rows with
+    unexpected fields or unsafe label values are ignored wholesale, preventing
+    raw excerpts or peer-card text from becoming ledger aggregates.
+    """
+
+    sources: List[Any] = []
+    aggregates = evidence.get("aggregates")
+    for source in (evidence, aggregates if isinstance(aggregates, Mapping) else None):
+        if not isinstance(source, Mapping):
+            continue
+        for key in _SAFE_PROBE_RESULT_LIST_KEYS:
+            value = source.get(key)
+            if isinstance(value, list):
+                sources.extend(value)
+
+    for item in sources:
+        if not isinstance(item, Mapping):
+            continue
+        raw_keys = {str(key) for key in item}
+        if not raw_keys or raw_keys - _SAFE_PROBE_RESULT_KEYS:
+            continue
+        safe_item: Dict[str, str] = {}
+        unsafe_value = False
+        for key, value in item.items():
+            label = _safe_probe_label(value)
+            if label is None:
+                unsafe_value = True
+                break
+            safe_item[str(key)] = label
+        if unsafe_value:
+            continue
+        yield safe_item
+
+
+def _failure_category_from_item(item: Mapping[str, str], reason: str) -> str:
+    category = item.get("category_label")
+    if category:
+        return category
+    labels = " ".join(
+        item.get(key, "")
+        for key in ("query_label", "source_label", "probe_label", "bucket_label")
+    )
+    if "peer_card" in labels or "peer-card" in labels:
+        return "peer_card"
+    if "session_context" in labels or "context" in labels:
+        return "session_context"
+    if "search" in labels or reason in {
+        "empty_recall",
+        "stale_retrieved_item",
+        "irrelevant_retrieval",
+        "noisy_retrieval",
+        "duplicate_retrieval",
+    }:
+        return "retrieval"
+    if reason == "regression_check_failure":
+        return "regression"
+    return "memory_quality"
+
+
+def _stale_reason_from_item(item: Mapping[str, str]) -> str:
+    labels = " ".join(item.get(key, "") for key in ("query_label", "source_label", "bucket_label"))
+    if "peer_card" in labels or "peer-card" in labels:
+        return "stale_card"
+    if "session_context" in labels or "context" in labels:
+        return "stale_context"
+    if "retriev" in labels or "search" in labels:
+        return "stale_retrieved_item"
+    return "stale_fact"
+
+
+def _failure_reasons_from_item(item: Mapping[str, str]) -> List[str]:
+    explicit = item.get("failure_reason_label")
+    if explicit:
+        return [explicit] if explicit in _SAFE_FAILURE_REASON_LABELS else []
+
+    reasons: List[str] = []
+    recall_label = item.get("recall_label") or item.get("recall_outcome")
+    freshness_label = item.get("freshness_label") or item.get("freshness_outcome")
+    noise_label = item.get("noise_label") or item.get("noise_outcome")
+    regression_label = item.get("regression_label") or item.get("regression_outcome")
+
+    if recall_label == "empty":
+        reasons.append("empty_recall")
+    elif recall_label in _RECALL_ERROR_LABELS:
+        reasons.append("tool_error")
+    elif recall_label == "irrelevant":
+        reasons.append("irrelevant_retrieval")
+    elif recall_label == "stale":
+        reasons.append("stale_retrieved_item")
+    elif recall_label in {"miss", "noisy"}:
+        reasons.append("noisy_retrieval")
+
+    if freshness_label in _STALE_FRESHNESS_LABELS:
+        reasons.append(_stale_reason_from_item(item))
+
+    if noise_label == "duplicate":
+        reasons.append("duplicate_retrieval")
+    elif noise_label == "irrelevant":
+        reasons.append("irrelevant_retrieval")
+    elif noise_label == "stale":
+        reasons.append("stale_retrieved_item")
+    elif noise_label == "empty":
+        reasons.append("empty_recall")
+    elif noise_label == "noisy":
+        reasons.append("noisy_retrieval")
+
+    if regression_label in _REGRESSION_FAILURE_LABELS:
+        reasons.append("regression_check_failure")
+
+    return list(dict.fromkeys(reasons))
+
+
+def _safe_probe_failure_details(evidence: Mapping[str, Any]) -> List[Dict[str, str]]:
+    details: List[Dict[str, str]] = []
+    seen: set[Tuple[Tuple[str, str], ...]] = set()
+    for item in _iter_safe_labeled_probe_results(evidence):
+        for reason in _failure_reasons_from_item(item):
+            detail: Dict[str, str] = {}
+            for key in ("query_label", "source_label", "probe_label", "bucket_label", "age_bucket_label"):
+                value = item.get(key)
+                if value:
+                    detail[key] = value
+            detail.setdefault("query_label", item.get("label") or item.get("probe_id") or "unknown")
+            detail["category_label"] = _failure_category_from_item(item, reason)
+            detail.setdefault("bucket_label", detail["category_label"])
+            detail["failure_reason_label"] = reason
+            key_tuple = tuple(sorted(detail.items()))
+            if key_tuple not in seen:
+                details.append(detail)
+                seen.add(key_tuple)
+    return details
+
+
+def _dedupe_probe_failure_details(details: Iterable[Mapping[str, str]]) -> List[Dict[str, str]]:
+    safe_details: List[Dict[str, str]] = []
+    seen: set[Tuple[Tuple[str, str], ...]] = set()
+    for item in details:
+        detail = dict(item)
+        key_tuple = tuple(sorted(detail.items()))
+        if key_tuple in seen:
+            continue
+        safe_details.append(detail)
+        seen.add(key_tuple)
+    return safe_details
+
+
+def _sanitize_probe_failure_details(value: Any) -> List[Dict[str, str]]:
+    if not isinstance(value, list):
+        return []
+    safe_details: List[Dict[str, str]] = []
+    for item in value:
+        if not isinstance(item, Mapping):
+            continue
+        raw_keys = {str(key) for key in item}
+        if not raw_keys or raw_keys - _SAFE_PROBE_FAILURE_DETAIL_KEYS:
+            continue
+        detail: Dict[str, str] = {}
+        for key, raw in item.items():
+            label = _safe_probe_label(raw)
+            if label is None:
+                detail = {}
+                break
+            detail[str(key)] = label
+        if detail and "failure_reason_label" in detail:
+            if detail["failure_reason_label"] not in _SAFE_FAILURE_REASON_LABELS:
+                continue
+            safe_details.append(detail)
+    return _dedupe_probe_failure_details(safe_details)
+
+
+def _all_safe_probe_failure_details(evidence: Mapping[str, Any]) -> List[Dict[str, str]]:
+    return _dedupe_probe_failure_details(
+        [
+            *_sanitize_probe_failure_details(evidence.get("safe_probe_failures")),
+            *_safe_probe_failure_details(evidence),
+        ]
+    )
+
+
+def _merge_failure_detail_label_counts(safe_aggs: Dict[str, Any], details: Iterable[Mapping[str, str]]) -> None:
+    counts: Dict[str, int] = {}
+    for detail in details:
+        reason = detail.get("failure_reason_label")
+        if reason not in _SAFE_FAILURE_REASON_LABELS:
+            continue
+        key = f"{reason}_label_count"
+        counts[key] = counts.get(key, 0) + 1
+    for key, value in counts.items():
+        existing = safe_aggs.get(key)
+        if isinstance(existing, bool):
+            existing_count = int(existing)
+        elif isinstance(existing, (int, float)):
+            existing_count = int(existing)
+        else:
+            existing_count = 0
+        safe_aggs[key] = max(existing_count, value)
+
+
+def _merge_labeled_probe_result_counts(safe_aggs: Dict[str, Any], evidence: Mapping[str, Any]) -> None:
+    recall_attempts = useful_recall = recall_errors = 0
+    fact_count = recent_facts = stale_facts = 0
+    retrieved_items = irrelevant_items = duplicate_items = stale_retrieved_items = empty_recalls = 0
+    regression_total = regression_failed = regression_passed = 0
+    accepted_rows = 0
+
+    for item in _iter_safe_labeled_probe_results(evidence):
+        accepted_rows += 1
+        recall_label = item.get("recall_label") or item.get("recall_outcome")
+        if recall_label:
+            recall_attempts += 1
+            retrieved_items += 1
+            if recall_label in _USEFUL_RECALL_LABELS:
+                useful_recall += 1
+            if recall_label in _RECALL_ERROR_LABELS:
+                recall_errors += 1
+            if recall_label in {"irrelevant", "miss"}:
+                irrelevant_items += 1
+            if recall_label == "stale":
+                stale_retrieved_items += 1
+            if recall_label == "empty":
+                empty_recalls += 1
+
+        freshness_label = item.get("freshness_label") or item.get("freshness_outcome")
+        if freshness_label:
+            fact_count += 1
+            if freshness_label in _RECENT_FRESHNESS_LABELS:
+                recent_facts += 1
+            if freshness_label in _STALE_FRESHNESS_LABELS:
+                stale_facts += 1
+                stale_retrieved_items += 1
+
+        noise_label = item.get("noise_label") or item.get("noise_outcome")
+        if noise_label:
+            retrieved_items += 1
+            if noise_label == "irrelevant":
+                irrelevant_items += 1
+            elif noise_label == "duplicate":
+                duplicate_items += 1
+            elif noise_label == "stale":
+                stale_retrieved_items += 1
+            elif noise_label in {"empty", "noisy"}:
+                empty_recalls += 1
+
+        regression_label = item.get("regression_label") or item.get("regression_outcome")
+        if regression_label:
+            regression_total += 1
+            if regression_label in _REGRESSION_FAILURE_LABELS:
+                regression_failed += 1
+            elif regression_label in _REGRESSION_PASS_LABELS:
+                regression_passed += 1
+
+    def set_if_absent(key: str, value: int) -> None:
+        if value and key not in safe_aggs:
+            safe_aggs[key] = value
+
+    set_if_absent("recall_attempts", recall_attempts)
+    set_if_absent("useful_recall_count", useful_recall)
+    set_if_absent("recall_error_count", recall_errors)
+    set_if_absent("fact_count", fact_count)
+    set_if_absent("recent_fact_count", recent_facts)
+    set_if_absent("stale_fact_count", stale_facts)
+    set_if_absent("retrieved_item_count", retrieved_items)
+    set_if_absent("irrelevant_item_count", irrelevant_items)
+    set_if_absent("duplicate_item_count", duplicate_items)
+    set_if_absent("stale_retrieved_item_count", stale_retrieved_items)
+    set_if_absent("empty_recall_count", empty_recalls)
+    set_if_absent("regression_checks_total", regression_total)
+    set_if_absent("regression_checks_failed", regression_failed)
+    set_if_absent("regression_checks_passed", regression_passed)
+    set_if_absent("fixed_probe_label_count", accepted_rows)
+
+
+def _omission(probe_id: str, reason: str) -> Dict[str, str]:
+    return {"id": probe_id, "reason": reason}
+
+
+def build_content_safe_probe_evidence(evidence: Mapping[str, Any]) -> Dict[str, Any]:
+    """Build sanitized hourly quality probe evidence from aggregate-only inputs.
+
+    The probe runner intentionally consumes only counts, ages, rates, booleans,
+    and deterministic labels. It never inspects or persists raw Honcho messages,
+    retrieved excerpts, peer-card text, or prompt/response bodies. When a probe
+    lacks enough aggregate evidence, the probe is omitted and recorded as
+    missing instead of guessing a score.
+    """
+
+    safe_aggs = _sanitized_aggregate_values(evidence)
+    _merge_labeled_probe_result_counts(safe_aggs, evidence)
+    safe_failures = _all_safe_probe_failure_details(evidence)
+    _merge_failure_detail_label_counts(safe_aggs, safe_failures)
+    probes: Dict[str, float] = {}
+    for name, value in _extract_probe_values(evidence).items():
+        if name in PROBE_DEFINITIONS:
+            normalized = _clamp01(value)
+            if normalized is not None:
+                probes[name] = normalized
+
+    omissions: List[Dict[str, str]] = []
+    queue_evidence_state = _queue_evidence_state(safe_aggs)
+    if queue_evidence_state is False:
+        safe_aggs.setdefault("queue_evidence_missing", True)
+        safe_aggs.setdefault("queue_evidence_state_label", "missing_or_failed")
+
+    recall_total = _count(safe_aggs, "recall_attempts", "recall_probe_count", "recall_total")
+    useful = _count(safe_aggs, "useful_recall_count", "actionable_recall_count", "relevant_recall_count")
+    recall_errors = _count(safe_aggs, "recall_error_count", "search_error_count") or 0.0
+    recall_ratio = _ratio(useful, recall_total)
+    if recall_ratio is None:
+        omissions.append(_omission("recall_usefulness", "insufficient_recall_counts"))
+    else:
+        error_penalty = 1.0 - min(1.0, recall_errors / recall_total) if recall_total else 0.0
+        probes["recall_usefulness"] = round(max(0.0, recall_ratio * error_penalty), 4)
+
+    total_facts = _count(safe_aggs, "fact_count", "memory_item_count", "representation_item_count")
+    recent_facts = _count(safe_aggs, "recent_fact_count", "recent_memory_item_count", "fresh_item_count")
+    stale_facts = _count(safe_aggs, "stale_fact_count", "stale_memory_item_count", "stale_item_count")
+    max_age = _number(safe_aggs, "max_age_hours", "max_fact_age_hours", "peer_card_age_hours")
+    max_expected_age = _number(safe_aggs, "max_expected_age_hours", "freshness_window_hours") or 168.0
+    freshness_score = _mean([
+        _ratio(recent_facts, total_facts),
+        (1.0 - _ratio(stale_facts, total_facts)) if _ratio(stale_facts, total_facts) is not None else None,
+        (1.0 - min(1.0, max_age / max_expected_age)) if max_age is not None and max_expected_age > 0 else None,
+    ])
+    if freshness_score is None:
+        omissions.append(_omission("freshness", "insufficient_age_or_freshness_counts"))
+    else:
+        probes["freshness"] = round(max(0.0, min(1.0, freshness_score)), 4)
+
+    retrieved_total = _count(safe_aggs, "retrieved_item_count", "memory_item_count", "recall_item_count", "recall_attempts")
+    noisy = sum(v or 0.0 for v in (
+        _count(safe_aggs, "irrelevant_item_count", "irrelevant_recall_count"),
+        _count(safe_aggs, "duplicate_item_count", "duplicate_memory_count"),
+        _count(safe_aggs, "stale_retrieved_item_count", "stale_recall_count"),
+        _count(safe_aggs, "empty_recall_count"),
+    ))
+    noise_score = _ratio(noisy, retrieved_total)
+    if noise_score is None:
+        omissions.append(_omission("noise", "insufficient_noise_counts"))
+    else:
+        probes["noise"] = round(noise_score, 4)
+
+    regression_total = _count(safe_aggs, "regression_checks_total", "fixed_probe_count", "regression_probe_count")
+    failed = _count(safe_aggs, "regression_checks_failed", "failed_regression_count", "regressed_probe_count")
+    if failed is None:
+        passed = _count(safe_aggs, "regression_checks_passed", "passed_regression_count")
+        failed = (regression_total - passed) if regression_total is not None and passed is not None else None
+    regression_score = _ratio(failed, regression_total)
+    if regression_score is None:
+        omissions.append(_omission("regression", "insufficient_regression_counts"))
+    else:
+        probes["regression"] = round(regression_score, 4)
+
+    dream_starts = _count(
+        safe_aggs,
+        "dream_start_markers",
+        "deriver_dream_start_markers",
+        "deriver_15m_dream_start_markers",
+        "deriver_2h_dream_start_markers",
+        "dream_started_count",
+    )
+    dream_completions = _count(
+        safe_aggs,
+        "dream_completion_markers",
+        "dream_completed_count",
+        "completed_dream_count",
+        "deriver_2h_completion_markers",
+        "deriver_2h_completion_with_errors_count",
+    )
+    dream_in_progress = _any_positive_count(
+        safe_aggs,
+        "active_dream_count",
+        "active_dream_rows",
+        "in_progress_dream_rows",
+        "pending_dream_rows",
+        "dream_queue_pending_rows",
+        "joy_talon_dream_active_count",
+        "joy_talon_dream_pending_count",
+    ) or bool(_bool_score(safe_aggs, "dream_in_progress", "active_dream") == 1.0)
+    if dream_in_progress:
+        safe_aggs.setdefault("dream_in_progress", True)
+        safe_aggs.setdefault("dream_state_label", "active_in_progress")
+
+    passive_observation = _safe_probe_label(safe_aggs.get("dream_observation_mode_label")) in {
+        "passive",
+        "passive_observation",
+        "natural",
+        "natural_observation",
+    } or bool(
+        _bool_score(
+            safe_aggs,
+            "dream_passive_observation",
+            "passive_dream_observation",
+            "dream_schedule_suppressed",
+        )
+        == 1.0
+    )
+    dream_schedule_attempted = _any_positive_count(
+        safe_aggs,
+        "dream_schedule_attempted",
+        "dream_schedule_attempt_count",
+        "schedule_dream_attempted",
+    )
+    if passive_observation:
+        safe_aggs.setdefault("dream_observation_mode_label", "passive")
+        safe_aggs.setdefault("dream_schedule_attempted", 0)
+
+    dream_progress = None if dream_in_progress else _mean([
+        1.0 if passive_observation and not dream_in_progress and not dream_schedule_attempted else None,
+        _ratio(dream_completions, dream_starts),
+        1.0 if dream_completions is not None and dream_completions > 0 else None,
+        _bool_score(safe_aggs, "dream_processed", "dream_queue_processed"),
+        _status_ok_score(safe_aggs, "dream_schedule_http_status", "dream_http_status", "scheduled_joy_talon_dream_http", ok_values=(200, 202, 204)),
+    ])
+    if passive_observation and not dream_in_progress and not dream_schedule_attempted:
+        safe_aggs.setdefault("dream_state_label", "passive_no_active_dream")
+    dream_health = _mean([
+        _bool_score(safe_aggs, "honcho_health_ok", "honcho_ok", "health_ok"),
+        _bool_score(safe_aggs, "cnpg_query_ok", "database_query_ok"),
+        _bool_score(safe_aggs, "k8s_rollouts_ok", "rollouts_ok"),
+        _zero_is_good_score(safe_aggs, "hermes_honcho_status_rc", "honcho_status_rc"),
+        _zero_is_good_score(safe_aggs, "queue_error_2h", "dream_queue_error_count", "dream_errors_2h"),
+        _zero_is_good_score(safe_aggs, "tracebacks", "traceback_count", "dream_tracebacks", "deriver_2h_traceback_count"),
+        _zero_is_good_score(safe_aggs, "incomplete", "incomplete_count", "incomplete_output_count", "deriver_2h_incomplete_count", tolerance=4.0),
+    ])
+    dream_score = None if dream_in_progress else _mean([dream_progress, dream_health])
+    if "dream_success" not in probes:
+        if queue_evidence_state is False:
+            omissions.append(_omission("dream_success", "queue_evidence_missing"))
+        elif dream_in_progress:
+            omissions.append(_omission("dream_success", "dream_active_in_progress"))
+        elif dream_score is None:
+            omissions.append(_omission("dream_success", "insufficient_dream_operational_counts"))
+        else:
+            probes["dream_success"] = round(max(0.0, min(1.0, dream_score)), 4)
+    elif queue_evidence_state is False:
+        probes.pop("dream_success", None)
+        omissions.append(_omission("dream_success", "queue_evidence_missing"))
+
+    representation_score = _mean([
+        _bool_score(safe_aggs, "card_context_readable", "peer_card_context_readable", "native_card_context_readable"),
+        _zero_is_good_score(safe_aggs, "hermes_honcho_status_rc", "honcho_status_rc"),
+        _zero_is_good_score(safe_aggs, "queue_error_2h", "representation_queue_error_count", "deriver_queue_error_count"),
+        # A large representation backlog is useful operational evidence, not a
+        # reason to omit the probe.  The 4096-row tolerance keeps the score
+        # bounded while still making backlog pressure visible in the report.
+        _zero_is_good_score(safe_aggs, "pending_representation_rows", "representation_pending_rows", "pending_deriver_rows", tolerance=4096.0),
+    ])
+    if "representation_freshness" not in probes:
+        if queue_evidence_state is False:
+            omissions.append(_omission("representation_freshness", "queue_evidence_missing"))
+        elif representation_score is None:
+            omissions.append(_omission("representation_freshness", "insufficient_representation_operational_counts"))
+        else:
+            probes["representation_freshness"] = round(max(0.0, min(1.0, representation_score)), 4)
+    elif queue_evidence_state is False:
+        probes.pop("representation_freshness", None)
+        omissions.append(_omission("representation_freshness", "queue_evidence_missing"))
+
+    limiter_failures = _sum_counts(
+        safe_aggs,
+        "limiter_15m_503",
+        "limiter_15m_503_count",
+        "limiter_45m_503_count",
+        "limiter_90m_503",
+        "limiter_90m_503_count",
+        "limiter_2h_503_count",
+        "limiter_503_count",
+        "limiter_15m_400",
+        "limiter_15m_400_count",
+        "limiter_45m_400_count",
+        "limiter_90m_400",
+        "limiter_90m_400_count",
+        "limiter_2h_400_count",
+        "limiter_400_count",
+        "limiter_15m_timeout",
+        "limiter_15m_timeout_count",
+        "limiter_45m_timeout_count",
+        "limiter_90m_timeout",
+        "limiter_90m_timeout_count",
+        "limiter_2h_timeout_count",
+        "limiter_timeout_count",
+    )
+    prompt_p95 = _number(
+        safe_aggs,
+        "limiter_15m_prompt_tokens_p95",
+        "limiter_45m_prompt_tokens_p95",
+        "limiter_90m_prompt_tokens_p95",
+        "limiter_2h_prompt_tokens_p95",
+        "prompt_tokens_p95",
+    )
+    completion_p95 = _number(
+        safe_aggs,
+        "limiter_15m_completion_tokens_p95",
+        "limiter_45m_completion_tokens_p95",
+        "limiter_90m_completion_tokens_p95",
+        "limiter_2h_completion_tokens_p95",
+        "completion_tokens_p95",
+    )
+    total_p95 = _number(
+        safe_aggs,
+        "limiter_15m_total_tokens_p95",
+        "limiter_45m_total_tokens_p95",
+        "limiter_90m_total_tokens_p95",
+        "limiter_2h_total_tokens_p95",
+        "total_tokens_p95",
+    )
+    token_score = _mean([
+        (1.0 - min(1.0, prompt_p95 / 8192.0)) if prompt_p95 is not None else None,
+        (1.0 - min(1.0, completion_p95 / 4096.0)) if completion_p95 is not None else None,
+        (1.0 - min(1.0, total_p95 / 12288.0)) if total_p95 is not None else None,
+    ])
+    dream_yield_score = _mean([
+        _clamp01(safe_aggs.get("dream_success")),
+        _ratio(
+            _count(safe_aggs, "observation_yield_marker_count", "observation_yield_markers"),
+            sum(v or 0.0 for v in (
+                _count(safe_aggs, "observation_yield_marker_count", "observation_yield_markers"),
+                _count(safe_aggs, "no_observation_marker_count", "no_observation_markers"),
+            )),
+        ),
+        _zero_is_good_score(safe_aggs, "no_observation_marker_count", "no_observation_markers", tolerance=4.0),
+    ])
+    budget_score = _mean([
+        (1.0 if limiter_failures == 0.0 else max(0.0, 1.0 - min(1.0, limiter_failures / 10.0)))
+        if limiter_failures is not None else None,
+        token_score,
+        _zero_is_good_score(
+            safe_aggs,
+            "finish_length",
+            "finish_length_count",
+            "deriver_45m_finish_length_count",
+            "deriver_2h_finish_length_count",
+            tolerance=8.0,
+        ),
+        _zero_is_good_score(
+            safe_aggs,
+            "limiter_45m_finish_length_count",
+            "limiter_90m_finish_length",
+            "finish_length_90m",
+            "limiter_2h_finish_length_count",
+            tolerance=12.0,
+        ),
+        _zero_is_good_score(
+            safe_aggs,
+            "deriver_45m_incomplete_llm_output_count",
+            "deriver_2h_incomplete_count",
+            "deriver_incomplete_llm_output_count",
+            tolerance=8.0,
+        ),
+        _zero_is_good_score(
+            safe_aggs,
+            "deriver_45m_tool_loop_max_count",
+            "deriver_2h_tool_loop_max_count",
+            "deriver_tool_loop_max_count",
+            tolerance=12.0,
+        ),
+        dream_yield_score,
+    ])
+    if "budget_efficiency" not in probes:
+        if _bool_score(safe_aggs, "budget_evidence_missing", "budget_efficiency_evidence_missing") == 1.0:
+            omissions.append(_omission("budget_efficiency", "budget_evidence_missing"))
+        elif queue_evidence_state is False and _has_any_key(safe_aggs, _QUEUE_DERIVED_KEYS):
+            omissions.append(_omission("budget_efficiency", "queue_evidence_missing"))
+        elif budget_score is None:
+            omissions.append(_omission("budget_efficiency", "insufficient_budget_operational_counts"))
+        else:
+            probes["budget_efficiency"] = round(max(0.0, min(1.0, budget_score)), 4)
+    elif _bool_score(safe_aggs, "budget_evidence_missing", "budget_efficiency_evidence_missing") == 1.0:
+        probes.pop("budget_efficiency", None)
+        omissions.append(_omission("budget_efficiency", "budget_evidence_missing"))
+    elif queue_evidence_state is False and _has_any_key(safe_aggs, _QUEUE_DERIVED_KEYS):
+        probes.pop("budget_efficiency", None)
+        omissions.append(_omission("budget_efficiency", "queue_evidence_missing"))
+
+    note = (
+        "content-safe hourly quality probe run; dream_active_in_progress"
+        if dream_in_progress
+        else "content-safe hourly quality probe run"
+    )
+    result: Dict[str, Any] = {
+        "probe_runner": SAFE_PROBE_RUNNER_ID,
+        "probe_labels": list(probes),
+        "probes": probes,
+        "aggregates": safe_aggs,
+        "omissions": omissions,
+        "note": note,
+    }
+    if safe_failures:
+        result["safe_probe_failures"] = safe_failures
+    return result
+
+
+def _warning_failure_detail_summary(probe_id: str, evidence: Mapping[str, Any]) -> str:
+    """Return a compact content-safe failure summary for probe warnings."""
+
+    wanted_reasons = _WARNING_FAILURE_REASONS_BY_PROBE.get(probe_id, set())
+    if not wanted_reasons:
+        return ""
+
+    details = [
+        detail
+        for detail in _all_safe_probe_failure_details(evidence)
+        if detail.get("failure_reason_label") in wanted_reasons
+    ]
+    rendered_details = [
+        rendered
+        for rendered in (_format_safe_probe_failure(detail) for detail in details[:3])
+        if rendered
+    ]
+    if rendered_details:
+        suffix = ""
+        if len(details) > len(rendered_details):
+            suffix = f"; +{len(details) - len(rendered_details)} more"
+        return "safe_failure_buckets: " + "; ".join(rendered_details) + suffix
+
+    aggregates = evidence.get("aggregates")
+    if not isinstance(aggregates, Mapping):
+        aggregates = evidence
+    safe_aggs = _sanitized_aggregate_values({"aggregates": aggregates})
+    count_labels = []
+    for reason in sorted(wanted_reasons):
+        key = f"{reason}_label_count"
+        value = _count(safe_aggs, key)
+        if value:
+            count_labels.append(f"{key}={int(value)}")
+    if count_labels:
+        return "safe_failure_counts: " + ", ".join(count_labels)
+    return ""
+
+
+def _warning_with_safe_detail(probe_id: str, warning: str, evidence: Mapping[str, Any]) -> str:
+    detail = _warning_failure_detail_summary(probe_id, evidence)
+    return f"{warning}; {detail}" if detail else warning
+
+
+def score_evidence(evidence: Mapping[str, Any]) -> ScoreResult:
+    raw = _extract_probe_values(evidence)
+    normalized: Dict[str, float] = {}
+    missing: List[str] = []
+    warnings: List[str] = []
+    weighted = 0.0
+    total_weight = 0.0
+
+    for name, definition in PROBE_DEFINITIONS.items():
+        value = _clamp01(raw.get(name))
+        if value is None:
+            missing.append(name)
+            continue
+        normalized[name] = value
+        weight = abs(float(definition["weight"]))
+        contribution = value if definition["direction"] == "higher_is_better" else 1.0 - value
+        weighted += contribution * weight
+        total_weight += weight
+        target = float(definition["target"])
+        if definition["direction"] == "higher_is_better" and value < target:
+            warning = f"{name} below target ({value:.2f} < {target:.2f})"
+            warnings.append(_warning_with_safe_detail(name, warning, evidence))
+        elif definition["direction"] == "lower_is_better" and value > target:
+            warning = f"{name} above target ({value:.2f} > {target:.2f})"
+            warnings.append(_warning_with_safe_detail(name, warning, evidence))
+
+    score = weighted / total_weight if total_weight else 0.0
+    return ScoreResult(score=round(score, 4), normalized=normalized, missing=missing, warnings=warnings)
+
+
+def _safe_note(text: Any, *, limit: int = 240) -> str:
+    if text is None:
+        return ""
+    value = " ".join(str(text).split())
+    blocked = ("BEGIN PRIVATE KEY", "api_key", "password", "token=", "Authorization:")
+    if any(marker.lower() in value.lower() for marker in blocked):
+        return "[redacted: unsafe note marker]"
+    return value[:limit]
+
+
+def _latest_run(ledger: Mapping[str, Any]) -> Optional[Mapping[str, Any]]:
+    runs = ledger.get("runs")
+    if isinstance(runs, list) and runs:
+        last = runs[-1]
+        if isinstance(last, Mapping):
+            return last
+    return None
+
+
+def _baseline(ledger: Mapping[str, Any]) -> Optional[Mapping[str, Any]]:
+    baselines = ledger.get("baselines")
+    if isinstance(baselines, list) and baselines:
+        item = baselines[-1]
+        if isinstance(item, Mapping):
+            return item
+    run = _latest_run(ledger)
+    return run
+
+
+def _delta(current: float, other: Optional[Mapping[str, Any]]) -> Optional[float]:
+    if not other:
+        return None
+    score = other.get("score")
+    if score is None:
+        return None
+    try:
+        return round(current - float(score), 4)
+    except (TypeError, ValueError):
+        return None
+
+
+def record_run(
+    evidence: Mapping[str, Any],
+    *,
+    path: Optional[str | Path] = None,
+    note: Optional[str] = None,
+    intervention_id: Optional[str] = None,
+    baseline: bool = False,
+    run_id: Optional[str] = None,
+) -> Tuple[Dict[str, Any], Dict[str, Any]]:
+    ledger = load_ledger(path)
+    prior = _latest_run(ledger)
+    base = _baseline(ledger)
+    scored = score_evidence(evidence)
+    now = utc_now_iso()
+    entry: Dict[str, Any] = {
+        "id": run_id or f"mq-{uuid.uuid4().hex[:10]}",
+        "recorded_at": now,
+        "score": scored.score,
+        "probes": scored.normalized,
+        "missing_probes": scored.missing,
+        "warnings": scored.warnings,
+        "delta_from_previous": _delta(scored.score, prior),
+        "delta_from_baseline": _delta(scored.score, base),
+        "intervention_id": _safe_note(intervention_id, limit=80) or None,
+        "note": _safe_note(note if note is not None else evidence.get("note")),
+    }
+    aggregates = evidence.get("aggregates")
+    if isinstance(aggregates, Mapping):
+        safe_aggs = _sanitized_aggregate_values({"aggregates": aggregates})
+        if safe_aggs:
+            entry["aggregates"] = safe_aggs
+
+    safe_failures = _sanitize_probe_failure_details(evidence.get("safe_probe_failures"))
+    if safe_failures:
+        entry["safe_probe_failures"] = safe_failures
+
+    omissions = evidence.get("omissions")
+    if isinstance(omissions, list):
+        safe_omissions = []
+        for item in omissions:
+            if not isinstance(item, Mapping):
+                continue
+            probe_id = str(item.get("id", ""))
+            reason = str(item.get("reason", ""))
+            if probe_id in PROBE_DEFINITIONS and _SAFE_LABEL_RE.fullmatch(reason):
+                safe_omissions.append({"id": probe_id, "reason": reason})
+        if safe_omissions:
+            entry["omitted_probe_details"] = safe_omissions
+
+    runs = ledger.setdefault("runs", [])
+    if not isinstance(runs, list):
+        runs = []
+        ledger["runs"] = runs
+    runs.append(entry)
+    del runs[:-MAX_RUNS]
+
+    if baseline or not ledger.get("baselines"):
+        baselines = ledger.setdefault("baselines", [])
+        if not isinstance(baselines, list):
+            baselines = []
+            ledger["baselines"] = baselines
+        baselines.append({
+            "id": f"baseline-{entry['id']}",
+            "source_run_id": entry["id"],
+            "recorded_at": now,
+            "score": entry["score"],
+            "probes": dict(entry["probes"]),
+            "note": "initial baseline" if not baseline else "operator-marked baseline",
+        })
+        del baselines[:-20]
+
+    save_ledger(ledger, path)
+    return ledger, entry
+
+
+def guidance(ledger: Optional[Mapping[str, Any]] = None) -> Dict[str, Any]:
+    ledger = ledger or load_ledger()
+    last = _latest_run(ledger)
+    base = _baseline(ledger)
+    active_interventions = [
+        item for item in ledger.get("interventions", [])
+        if isinstance(item, Mapping) and item.get("status") in {"active", "watching"}
+    ]
+    recommendations = [
+        "Before filing a Honcho-memory Agent Request, compare current probe scores to delta_from_baseline and delta_from_previous.",
+        "File only when a concrete metric regression/opportunity is not already covered by a nonterminal Agent Request.",
+        "Include probe ids, aggregate counts, deltas, and acceptance criteria; never include raw messages, peer-card text, or secrets.",
+        "For hourly_cron, collect native honcho_profile/context/search outcomes as fixed labels only: query_label/probe_label plus recall/freshness/noise/regression pass/fail labels. Feed those labels or their counts to eval probe; never persist excerpts.",
+        "When a north-star regression warning repeats, cite safe_probe_failures entries such as query_label/category_label/bucket_label/failure_reason_label and *_label_count aggregates to target the failing recall/freshness/regression bucket without raw content.",
+        "For passive hourly dream observation, do not induce/schedule dreams; report dream_observation_mode_label=passive and dream_schedule_attempted=0 so no active/pending dream can score as healthy when service and queue evidence are clean.",
+    ]
+    if last:
+        missing = last.get("missing_probes") or []
+        probes = last.get("probes") or {}
+        if missing and not probes:
+            recommendations.append("No probes were scored; treat this run as measurement-insufficient rather than a memory-quality regression.")
+        elif missing:
+            recommendations.append("Missing probes mean evidence is incomplete for those labels; evaluate scored probes separately before treating deltas as a quality regression.")
+        if last.get("delta_from_baseline") is not None and float(last["delta_from_baseline"]) < -0.05:
+            recommendations.append("Current score regressed more than 0.05 below baseline; prioritize regression/root-cause investigation.")
+        if last.get("warnings"):
+            recommendations.append("Open warnings identify the concrete probe areas to address before broad tuning.")
+    return {
+        "ledger_schema_version": LEDGER_SCHEMA_VERSION,
+        "last_run": last,
+        "baseline": base,
+        "active_interventions": active_interventions,
+        "probe_definitions": PROBE_DEFINITIONS,
+        "input_contract": SAFE_PROBE_INPUT_CONTRACT,
+        "recurring_probes": DEFAULT_RECURRING_PROBES,
+        "recommendations": recommendations,
+    }
+
+
+def _format_safe_probe_failure(detail: Mapping[str, Any]) -> str:
+    parts: List[str] = []
+    for key in (
+        "query_label",
+        "probe_label",
+        "source_label",
+        "category_label",
+        "bucket_label",
+        "failure_reason_label",
+        "age_bucket_label",
+    ):
+        value = detail.get(key)
+        if isinstance(value, str) and _SAFE_LABEL_RE.fullmatch(value):
+            parts.append(f"{key}={value}")
+    return " ".join(parts)
+
+
+def _safe_failure_label_count_lines(aggregates: Mapping[str, Any]) -> List[str]:
+    items: List[str] = []
+    for key, value in sorted(aggregates.items()):
+        if not key.endswith("_label_count"):
+            continue
+        if not isinstance(value, (int, float)) or isinstance(value, bool):
+            continue
+        if not math.isfinite(float(value)):
+            continue
+        reason = key[: -len("_label_count")]
+        if reason in _SAFE_FAILURE_REASON_LABELS:
+            items.append(f"{key}={int(value)}")
+    return items
+
+
+def render_report(data: Mapping[str, Any]) -> str:
+    lines = ["Honcho memory-quality evaluation"]
+    last = data.get("last_run")
+    base = data.get("baseline")
+    if not last:
+        lines.append("No runs recorded yet. Record aggregate probe scores to establish a baseline.")
+    else:
+        lines.append(f"Last run: {last.get('id')} score={float(last.get('score', 0.0)):.3f}")
+        lines.append(f"Δ previous: {last.get('delta_from_previous')}  Δ baseline: {last.get('delta_from_baseline')}")
+        if base:
+            lines.append(f"Baseline: {base.get('id') or base.get('source_run_id')} score={float(base.get('score', 0.0)):.3f}")
+        if last.get("warnings"):
+            lines.append("Warnings: " + "; ".join(str(w) for w in last.get("warnings", [])))
+        if last.get("missing_probes"):
+            lines.append("Missing probes: " + ", ".join(str(m) for m in last.get("missing_probes", [])))
+            if last.get("probes"):
+                lines.append("Measurement note: missing probes mark insufficient evidence for those labels; scored probes remain valid operational evidence.")
+            else:
+                lines.append("Measurement note: no probes scored, so this run is measurement-insufficient rather than evidence of memory-quality regression.")
+        safe_failures = last.get("safe_probe_failures")
+        if isinstance(safe_failures, list) and safe_failures:
+            lines.append("Safe failure buckets:")
+            rendered_count = 0
+            for detail in safe_failures[:8]:
+                if not isinstance(detail, Mapping):
+                    continue
+                rendered = _format_safe_probe_failure(detail)
+                if rendered:
+                    lines.append(f"- {rendered}")
+                    rendered_count += 1
+            remaining = len(safe_failures) - rendered_count
+            if remaining > 0:
+                lines.append(f"- ... {remaining} more safe failure bucket(s)")
+        aggregates = last.get("aggregates")
+        if isinstance(aggregates, Mapping):
+            failure_counts = _safe_failure_label_count_lines(aggregates)
+            if failure_counts:
+                lines.append("Safe failure counts: " + ", ".join(failure_counts))
+    lines.append("Guidance:")
+    for rec in data.get("recommendations", []):
+        lines.append(f"- {rec}")
+    return "\n".join(lines)
+
+
+__all__ = [
+    "DEFAULT_LEDGER_RELATIVE_PATH",
+    "DEFAULT_RECURRING_PROBES",
+    "LEDGER_SCHEMA_VERSION",
+    "PROBE_DEFINITIONS",
+    "QUALITY_PROBE_IDS",
+    "SAFE_PROBE_INPUT_CONTRACT",
+    "SAFE_PROBE_RUNNER_ID",
+    "build_content_safe_probe_evidence",
+    "guidance",
+    "ledger_path",
+    "load_ledger",
+    "record_run",
+    "render_report",
+    "save_ledger",
+    "score_evidence",
+]
