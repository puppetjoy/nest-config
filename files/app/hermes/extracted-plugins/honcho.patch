+def cmd_identity_audit(args) -> None:
+    """Audit a peer card for identity/entity-relation conflation."""
+    from .identity_audit import audit_peer_card_identity_relations
+
+    def _read_lines(path: str | None) -> list[str]:
+        if not path:
+            return []
+        text = Path(path).read_text(encoding="utf-8")
+        try:
+            loaded = json.loads(text)
+            if isinstance(loaded, list):
+                return [str(item) for item in loaded]
+            if isinstance(loaded, dict) and isinstance(loaded.get("card"), list):
+                return [str(item) for item in loaded["card"]]
+        except Exception:
+            pass
+        return [line.strip() for line in text.splitlines() if line.strip()]
+
+    card = _read_lines(getattr(args, "card_file", None))
+    evidence_texts = _read_lines(getattr(args, "evidence_file", None))
+    peer = getattr(args, "peer", None) or "user"
+
+    cfg = _read_config()
+    known_entities = list(getattr(args, "known_entity", None) or [])
+    # Include configured/profile AI peer names as collision candidates. Operators
+    # can pass extra --known-entity values for agents/services not visible in the
+    # current config; this keeps the command read-only and review-oriented.
+    for _, _host, block in _all_profile_host_configs():
+        value = block.get("aiPeer")
+        if value:
+            known_entities.append(str(value))
+    value = cfg.get("aiPeer")
+    if value:
+        known_entities.append(str(value))
+
+    if not card:
+        try:
+            from .client import HonchoClientConfig, get_honcho_client, reset_honcho_client
+            from .session import HonchoSessionManager
+
+            reset_honcho_client()
+            hcfg = HonchoClientConfig.from_global_config(host=_host_key())
+            client = get_honcho_client(hcfg)
+            mgr = HonchoSessionManager(honcho=client, config=hcfg)
+            session_key = hcfg.resolve_session_name() or "default"
+            mgr.get_or_create(session_key)
+            card = mgr.get_peer_card(session_key, peer=peer)
+        except Exception as e:
+            print(f"  Could not fetch Honcho peer card: {e}")
+            print("  Pass --card-file with one fact per line or a JSON list to run offline.\n")
+            return
+
+    report = audit_peer_card_identity_relations(
+        card,
+        peer=peer,
+        evidence_texts=evidence_texts,
+        known_entity_names=known_entities,
+    )
+
+    if getattr(args, "json", False):
+        print(json.dumps(report.as_dict(), indent=2, sort_keys=True))
+        return
+
+    print("\nHoncho identity relation audit\n" + "─" * 34)
+    print(f"  Peer: {report.peer}")
+    print(f"  Review required: {'yes' if report.review_required else 'no'}")
+    print(f"  {report.summary}")
+    if report.findings:
+        print("\nFindings:")
+        for finding in report.findings:
+            print(f"  - {finding.severity}: {finding.field}={finding.value!r}")
+            print(f"    fact: {finding.fact}")
+            for reason in finding.reasons:
+                print(f"    reason: {reason}")
+            print(f"    proposal: {finding.proposal}")
+    print("\nProposed peer card for review:")
+    for fact in report.proposed_card:
+        print(f"  - {fact}")
+    print("\nIntegration notes:")
+    for note in report.integration_notes:
+        print(f"  - {note}")
+    print()
