+
+    if action == "probe":
+        input_path = getattr(args, "input", None)
+        if input_path in (None, "-"):
+            payload = sys.stdin.read()
+        else:
+            payload = Path(input_path).read_text(encoding="utf-8")
+        try:
+            raw_evidence = json.loads(payload or "{}")
+        except json.JSONDecodeError as e:
+            raise SystemExit(f"Invalid JSON evidence: {e}") from e
+        if not isinstance(raw_evidence, dict):
+            raise SystemExit("Evidence must be a JSON object")
+        evidence = build_content_safe_probe_evidence(raw_evidence)
+        if getattr(args, "record", False):
+            _ledger, entry = record_run(
+                evidence,
+                path=path,
+                note=getattr(args, "note", None),
+                intervention_id=getattr(args, "intervention", None),
+                baseline=bool(getattr(args, "baseline", False)),
+            )
+            print(json.dumps(entry, indent=2, sort_keys=True))
+        else:
+            print(json.dumps(evidence, indent=2, sort_keys=True))
