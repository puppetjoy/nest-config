+"""Peer-card identity/relation quality audit helpers for Honcho.
+
+The audit is intentionally proposal-only.  High-trust identity facts such as
+names, aliases, pronouns, and roles should not be rewritten silently from an
+agent heuristic; callers surface the report for human review instead.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from typing import Any, Iterable
+
+
+_DEFAULT_RESERVED_ENTITY_NAMES = {
+    "agent",
+    "assistant",
+    "beryl",
+    "beryl bee",
+    "claude",
+    "codex",
+    "eyrie",
+    "gemini",
+    "gpt",
+    "hermes",
+    "honcho",
+    "joy agent",
+    "openai",
+    "openrouter",
+    "puppet",
+    "qwen",
+    "star",
+    "talon",
+}
+
+_STRONG_ALIAS_EVIDENCE_PATTERNS = (
+    re.compile(r"\b(?:call|called|calls)\s+(?:me|the user|them|him|her)\s+(?:by\s+)?['\"]?{alias}['\"]?\b", re.I),
+    re.compile(r"\b(?:i|the user|they|he|she)\s+(?:also\s+)?(?:go|goes|went)\s+by\s+['\"]?{alias}['\"]?\b", re.I),
+    re.compile(r"\b(?:my|their|the user's)\s+(?:alias|nickname|preferred name)\s+is\s+['\"]?{alias}['\"]?\b", re.I),
+    re.compile(r"\b(?:i am|i'm|they are|the user is)\s+(?:also\s+)?(?:known as|called)\s+['\"]?{alias}['\"]?\b", re.I),
+)
+
+_RELATIONSHIP_HINT_RE = re.compile(
+    r"\b(?:agent|assistant|bot|service|tool|profile|works? with|uses?|administers?|owns?|operates?)\b",
+    re.I,
+)
+
+_ALIAS_FIELD_RE = re.compile(
+    r"^(?:(?P<section>[A-Z][A-Z _-]*):\s*)?(?P<label>aliases?|also known as|nicknames?)\s*:\s*(?P<value>.+)$",
+    re.I,
+)
+
+
+@dataclass(frozen=True)
+class AliasCandidate:
+    """One alias-like value extracted from a peer-card fact."""
+
+    value: str
+    fact_index: int
+    fact: str
+
+
+@dataclass(frozen=True)
+class IdentityAuditFinding:
+    """A reviewable issue found in a peer card."""
+
+    code: str
+    severity: str
+    field: str
+    value: str
+    fact: str
+    reasons: tuple[str, ...]
+    evidence_status: str
+    proposal: str
+
+    def as_dict(self) -> dict[str, Any]:
+        return {
+            "code": self.code,
+            "severity": self.severity,
+            "field": self.field,
+            "value": self.value,
+            "fact": self.fact,
+            "reasons": list(self.reasons),
+            "evidence_status": self.evidence_status,
+            "proposal": self.proposal,
+        }
+
+
+@dataclass(frozen=True)
+class IdentityAuditReport:
+    """Proposal-only peer-card audit report."""
+
+    peer: str
+    findings: tuple[IdentityAuditFinding, ...] = ()
+    proposed_card: tuple[str, ...] = ()
+    review_required: bool = True
+    summary: str = ""
+    integration_notes: tuple[str, ...] = field(default_factory=tuple)
+
+    def as_dict(self) -> dict[str, Any]:
+        return {
+            "peer": self.peer,
+            "review_required": self.review_required,
+            "summary": self.summary,
+            "findings": [finding.as_dict() for finding in self.findings],
+            "proposed_card": list(self.proposed_card),
+            "integration_notes": list(self.integration_notes),
+        }
+
+
+def _normalize_name(value: str) -> str:
+    return re.sub(r"[^a-z0-9]+", " ", value.lower()).strip()
+
+
+def _split_alias_values(raw: str) -> list[str]:
+    raw = raw.strip().strip("[]")
+    values = re.split(r",|/|;|\band\b", raw, flags=re.I)
+    cleaned = []
+    for value in values:
+        value = value.strip().strip("'\"`*-")
+        if value:
+            cleaned.append(value)
+    return cleaned
+
+
+def extract_alias_candidates(card: Iterable[str]) -> list[AliasCandidate]:
+    """Return alias values explicitly stored in alias-like peer-card fields."""
+
+    candidates: list[AliasCandidate] = []
+    for index, fact in enumerate(card):
+        match = _ALIAS_FIELD_RE.match(str(fact).strip())
+        if not match:
+            continue
+        for value in _split_alias_values(match.group("value")):
+            candidates.append(AliasCandidate(value=value, fact_index=index, fact=str(fact)))
+    return candidates
+
+
+def _has_strong_alias_evidence(alias: str, evidence_texts: Iterable[str]) -> bool:
+    escaped = re.escape(alias)
+    for text in evidence_texts:
+        for pattern in _STRONG_ALIAS_EVIDENCE_PATTERNS:
+            if pattern.pattern.format(alias=escaped):
+                compiled = re.compile(pattern.pattern.format(alias=escaped), pattern.flags)
+                if compiled.search(text):
+                    return True
+    return False
+
+
+def _relationship_targets_from_card(
+    card: Iterable[str],
+    suspicious_aliases: Iterable[str],
+    known_entity_names: Iterable[str] = (),
+) -> list[str]:
+    """Infer relationship target names that should be preserved in a typed relation."""
+
+    names: list[str] = []
+    seen: set[str] = set()
+    alias_by_norm = {_normalize_name(alias): alias for alias in suspicious_aliases}
+    known_by_norm = {
+        _normalize_name(name): str(name).strip()
+        for name in known_entity_names
+        if str(name).strip()
+    }
+    candidates_by_norm = {**known_by_norm, **alias_by_norm}
+
+    for fact in card:
+        fact_text = str(fact)
+        if not _RELATIONSHIP_HINT_RE.search(fact_text):
+            continue
+        for norm, name in candidates_by_norm.items():
+            if re.search(rf"\b{re.escape(name)}\b", fact_text, re.I) and norm not in seen:
+                names.append(name)
+                seen.add(norm)
+
+    for alias in suspicious_aliases:
+        norm = _normalize_name(alias)
+        if norm not in seen:
+            names.append(alias)
+            seen.add(norm)
+    return names
+
+
+def _join_names(names: list[str]) -> str:
+    if not names:
+        return ""
+    if len(names) == 1:
+        return names[0]
+    if len(names) == 2:
+        return f"{names[0]} and {names[1]}"
+    return f"{', '.join(names[:-1])}, and {names[-1]}"
+
+
+def _rewrite_alias_fact(fact: str, suspicious_values: set[str]) -> str | None:
+    match = _ALIAS_FIELD_RE.match(fact.strip())
+    if not match:
+        return fact
+    remaining = [
+        value for value in _split_alias_values(match.group("value"))
+        if _normalize_name(value) not in suspicious_values
+    ]
+    if not remaining:
+        return None
+    prefix = ""
+    if match.group("section"):
+        prefix = f"{match.group('section')}: "
+    label = match.group("label")
+    return f"{prefix}{label}: {', '.join(remaining)}"
+
+
+def audit_peer_card_identity_relations(
+    card: Iterable[str],
+    *,
+    peer: str = "user",
+    evidence_texts: Iterable[str] = (),
+    known_entity_names: Iterable[str] = (),
+) -> IdentityAuditReport:
+    """Audit a Honcho peer card for alias/entity-relation conflation.
+
+    The audit flags alias entries that collide with known agents/services or
+    relationship targets unless raw evidence strongly supports the alias claim.
+    It returns a proposed replacement card for review; it never mutates Honcho.
+    """
+
+    card_list = [str(fact) for fact in card if str(fact).strip()]
+    reserved = {_normalize_name(name) for name in _DEFAULT_RESERVED_ENTITY_NAMES}
+    reserved.update(_normalize_name(name) for name in known_entity_names if str(name).strip())
+
+    candidates = extract_alias_candidates(card_list)
+    findings: list[IdentityAuditFinding] = []
+    suspicious_norms: set[str] = set()
+    suspicious_values: list[str] = []
+
+    for candidate in candidates:
+        norm = _normalize_name(candidate.value)
+        if not norm:
+            continue
+        has_evidence = _has_strong_alias_evidence(candidate.value, evidence_texts)
+        reasons: list[str] = []
+        collides_with_entity = norm in reserved
+        appears_as_relationship = any(
+            _RELATIONSHIP_HINT_RE.search(fact)
+            and re.search(rf"\b{re.escape(candidate.value)}\b", fact, re.I)
+            for fact in card_list
+        )
+        if collides_with_entity:
+            reasons.append("alias collides with a known agent, profile, service, or infrastructure entity")
+        if appears_as_relationship:
+            reasons.append("same name appears in relationship/service context on the peer card")
+        if (collides_with_entity or appears_as_relationship) and not has_evidence:
+            reasons.append("no strong raw alias evidence such as 'call me X' or 'I also go by X' was supplied")
+        if not reasons or has_evidence:
+            continue
+
+        suspicious_norms.add(norm)
+        suspicious_values.append(candidate.value)
+        findings.append(
+            IdentityAuditFinding(
+                code="identity_relation_conflation",
+                severity="high" if norm in reserved else "medium",
+                field="aliases",
+                value=candidate.value,
+                fact=candidate.fact,
+                reasons=tuple(reasons),
+                evidence_status="missing_strong_alias_evidence",
+                proposal="Remove from Aliases after review and preserve as a typed relationship if applicable.",
+            )
+        )
+
+    relationship_targets = _relationship_targets_from_card(
+        card_list,
+        suspicious_values,
+        known_entity_names=known_entity_names,
+    )
+    relationship_fact = ""
+    if relationship_targets:
+        relationship_fact = f"Works with AI agents including {_join_names(relationship_targets)}"
+
+    proposed: list[str] = []
+    for fact in card_list:
+        rewritten = _rewrite_alias_fact(fact, suspicious_norms)
+        if rewritten:
+            proposed.append(rewritten)
+    if relationship_fact and not any(_normalize_name(fact) == _normalize_name(relationship_fact) for fact in proposed):
+        proposed.append(relationship_fact)
+
+    if findings:
+        summary = (
+            f"Found {len(findings)} suspicious alias identity claim(s) on peer '{peer}'; "
+            "review proposed typed relationship replacements before mutating Honcho."
+        )
+    else:
+        summary = f"No suspicious alias/entity-relation conflation found on peer '{peer}'."
+
+    integration_notes = (
+        "Run after Honcho peer-card refreshes in the self-improvement loop and include the report in the memory-quality artifact.",
+        "Treat identity fields (Name, Aliases, Pronouns, Role) as high-trust: create reviewable proposals, do not auto-delete or auto-rewrite.",
+        "Pass known Hermes profiles/agents/services as collision names so aliases that are really relationship targets are flagged.",
+        "Use raw Honcho/session excerpts as evidence_texts; only strong phrases such as 'call me X' or 'I also go by X' should suppress an alias warning.",
+    )
+    return IdentityAuditReport(
+        peer=peer,
+        findings=tuple(findings),
+        proposed_card=tuple(proposed),
+        review_required=bool(findings),
+        summary=summary,
+        integration_notes=integration_notes,
+    )
