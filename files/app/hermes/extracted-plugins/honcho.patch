+def ledger_path(path: Optional[str | Path] = None) -> Path:
+    if path:
+        return Path(path).expanduser()
+    return get_hermes_home() / DEFAULT_LEDGER_RELATIVE_PATH
+
+
+def utc_now_iso() -> str:
+    return datetime.now(timezone.utc).isoformat(timespec="seconds")
+
+
+def _default_ledger() -> Dict[str, Any]:
+    return {
+        "schema_version": LEDGER_SCHEMA_VERSION,
+        "created_at": utc_now_iso(),
+        "updated_at": None,
+        "safety": {
+            "content_safe": True,
+            "rules": [
+                "Store only scores, aggregate counts, hashes/labels, and short non-secret notes.",
+                "Do not store raw message content, peer-card text, secrets, API responses, or prompt bodies.",
+                "Agent Requests are filed only after comparing current evidence with this ledger and active requests.",
+            ],
+        },
+        "probes": DEFAULT_RECURRING_PROBES,
+        "baselines": [],
+        "interventions": [],
+        "runs": [],
+    }
+
+
+def load_ledger(path: Optional[str | Path] = None) -> Dict[str, Any]:
+    p = ledger_path(path)
+    if not p.exists():
+        return _default_ledger()
+    try:
+        data = json.loads(p.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return _default_ledger()
+    if not isinstance(data, dict):
+        return _default_ledger()
+    base = _default_ledger()
+    base.update(data)
+    base.setdefault("probes", DEFAULT_RECURRING_PROBES)
+    base.setdefault("baselines", [])
+    base.setdefault("interventions", [])
+    base.setdefault("runs", [])
+    return base
+
+
+def save_ledger(data: Mapping[str, Any], path: Optional[str | Path] = None) -> Path:
+    p = ledger_path(path)
+    mutable = dict(data)
+    mutable["schema_version"] = LEDGER_SCHEMA_VERSION
+    mutable["updated_at"] = utc_now_iso()
+    atomic_json_write(p, mutable, indent=2, sort_keys=True)
+    return p
+
