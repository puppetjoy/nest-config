     print()
 
 
+_NATIVE_PROBE_QUERIES = (
+    ("identity", "stable identity and role preferences"),
+    ("workflow", "current project workflow and review preferences"),
+    ("memory_quality", "Honcho memory quality evaluation goals"),
+    ("agent_requests", "Agent Request routing and review policy"),
+)
+_NATIVE_SAFE_PEER_LABELS = {"user": "user", "ai": "ai"}
+
+
+def _native_safe_peer_label(peer: str, index: int) -> str:
+    """Return a deterministic non-PII peer bucket for native eval labels."""
+
+    normalized = peer.strip().lower()
+    return _NATIVE_SAFE_PEER_LABELS.get(normalized, f"custom_peer_{index}")
+
+
+def _native_context_has_recall(context: object) -> bool:
+    """Return whether a context payload contains non-card recall evidence."""
+
+    if not isinstance(context, dict):
+        return False
+    return any(context.get(key) for key in ("summary", "representation", "recent_messages"))
+
+
+def _native_peer_card_omission_reason(peer_label: str, context: object) -> str | None:
+    """Return a safe omission label for an empty peer-card probe.
+
+    Self-hosted Honcho can have a useful AI self-representation before a
+    first-class AI peer card exists. Treat that as measurement-degraded
+    evidence instead of counting the missing card as a regression failure or as
+    a successful recall row. User peer-card gaps still fail normally because the
+    user card is the primary native profile surface.
+    """
+
+    if peer_label == "ai" and _native_context_has_recall(context):
+        return "ai_peer_card_missing_context_available"
+    return None
+
+
+def _native_honcho_probe_rows(peers: list[str] | tuple[str, ...] | None = None) -> dict[str, object]:
+    """Collect fixed-label Honcho probe rows without returning raw memory content.
+
+    The hourly self-improvement cron needs native Honcho evidence, but the eval
+    ledger must not persist retrieved excerpts, peer-card text, or session
+    context.  This helper inspects those native surfaces in-process and emits
+    only deterministic labels/counts that `eval probe` can safely sanitize and
+    score.
+    """
+
+    from .client import HonchoClientConfig, get_honcho_client
+    from .session import HonchoSessionManager
+
+    hcfg = HonchoClientConfig.from_global_config(host=_host_key())
+    if not hcfg.enabled:
+        raise RuntimeError("Honcho is disabled for the active profile")
+    if not (hcfg.api_key or hcfg.base_url):
+        raise RuntimeError("Honcho has no API key or base URL configured")
+
+    client = get_honcho_client(hcfg)
+    manager = HonchoSessionManager(honcho=client, config=hcfg)
+    session_key = hcfg.resolve_session_name() or hcfg.workspace_id
+    manager.get_or_create(session_key)
+
+    selected_peers = tuple(peers or ("user", "ai"))
+    rows: list[dict[str, str]] = []
+    attempts = 0
+    errors = 0
+    omissions: dict[str, int] = {}
+
+    def add_row(
+        label: str,
+        *,
+        ok: bool,
+        empty: bool = False,
+        error: bool = False,
+        category: str = "native_probe",
+    ) -> None:
+        nonlocal attempts, errors
+        attempts += 1
+        if error:
+            errors += 1
+        failure_reason = "tool_error" if error else ("empty_recall" if empty else None)
+        row = {
+            "query_label": label,
+            "category_label": category,
+            "bucket_label": category,
+            "recall_label": "tool_error" if error else ("empty" if empty else "useful"),
+            "freshness_label": "stale" if error or empty else "fresh",
+            "noise_label": "empty" if empty else "clean",
+            "regression_label": "fail" if error or not ok else "pass",
+        }
+        if failure_reason:
+            row["failure_reason_label"] = failure_reason
+        rows.append(row)
+
+    def add_omission(reason: str) -> None:
+        omissions[reason] = omissions.get(reason, 0) + 1
+
+    for peer_index, peer in enumerate(selected_peers):
+        peer_label = _native_safe_peer_label(str(peer), peer_index)
+        context: dict[str, object] | None = None
+        context_error = False
+        try:
+            context = manager.get_session_context(session_key, peer=peer)
+        except Exception:
+            context_error = True
+
+        try:
+            card = manager.get_peer_card(session_key, peer=peer)
+            omission_reason = None
+            if not card:
+                omission_reason = _native_peer_card_omission_reason(peer_label, context)
+            if omission_reason:
+                add_omission(omission_reason)
+            else:
+                add_row(f"peer_card:{peer_label}", ok=bool(card), empty=not bool(card), category="peer_card")
+        except Exception:
+            add_row(f"peer_card:{peer_label}", ok=False, error=True, category="peer_card")
+
+        if context_error:
+            add_row(f"session_context:{peer_label}", ok=False, error=True, category="session_context")
+        else:
+            context_keys = ("summary", "representation", "card", "recent_messages")
+            has_context = (
+                any(context.get(key) for key in context_keys)
+                if isinstance(context, dict)
+                else False
+            )
+            add_row(
+                f"session_context:{peer_label}",
+                ok=has_context,
+                empty=not has_context,
+                category="session_context",
+            )
+
+        for query_label, query in _NATIVE_PROBE_QUERIES:
+            try:
+                result = manager.search_context(session_key, query, max_tokens=600, peer=peer)
+                add_row(f"search:{peer_label}:{query_label}", ok=bool(result), empty=not bool(result), category="retrieval")
+            except Exception:
+                add_row(f"search:{peer_label}:{query_label}", ok=False, error=True, category="retrieval")
+
+    aggregates: dict[str, object] = {
+        "probe_window_label": "hourly-light",
+        "native_honcho_probe_attempts": attempts,
+        "native_honcho_probe_error_count": errors,
+        "native_honcho_probe_results": rows,
+    }
+    if omissions:
+        aggregates["native_honcho_probe_omission_count"] = sum(omissions.values())
+        for reason, count in sorted(omissions.items()):
+            aggregates[f"native_honcho_probe_omitted_{reason}_count"] = count
+
+    return {"aggregates": aggregates}
+
+
+def cmd_eval(args) -> None:
+    """Manage the content-safe Honcho memory-quality evaluation ledger."""
+    from .evaluation import (
+        build_content_safe_probe_evidence,
+        guidance,
+        ledger_path,
+        load_ledger,
+        record_run,
+        render_report,
+        save_ledger,
+    )
+
+    action = getattr(args, "eval_command", None) or "report"
+    path = getattr(args, "ledger", None)
+
+    if action == "init":
+        p = save_ledger(load_ledger(path), path)
+        print(f"Initialized Honcho memory-quality ledger: {p}")
+        return
+
+    if action == "path":
+        print(ledger_path(path))
+        return
+
+    if action == "record":
+        input_path = getattr(args, "input", None)
+        if input_path in (None, "-"):
+            payload = sys.stdin.read()
+        else:
+            payload = Path(input_path).read_text(encoding="utf-8")
+        try:
+            evidence = json.loads(payload or "{}")
+        except json.JSONDecodeError as e:
+            raise SystemExit(f"Invalid JSON evidence: {e}") from e
+        if not isinstance(evidence, dict):
+            raise SystemExit("Evidence must be a JSON object")
