#!/usr/bin/env python3
"""Create and retain truthful full-Hermes backup generations."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import fcntl
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import zipfile
from pathlib import Path


GENERATION_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9_.-]*\Z")
ARCHIVE_RE = re.compile(r"\Ahermes-home-([A-Za-z0-9][A-Za-z0-9_.-]*)\.zip\Z")
LEGACY_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9_.-]*-hermes-\d{8}-\d{6}\.zip\Z")
DEFAULT_PROFILES = ("talon", "star", "beryl", "quill")
REQUIRED_SHARED = ("config.yaml", "auth.json", "kanban.db")
HOLD_RE = re.compile(r"\A\.generation-hold-([A-Za-z0-9][A-Za-z0-9_-]{0,63})\.json\Z")
HOLD_FIELDS = {'schema', 'kind', 'hold_id', 'release', 'checkpoint', 'archive', 'sha256',
               'bytes', 'members', 'required_profiles'}


def _archive_for(backup_dir: Path, checkpoint: str) -> Path:
    if not GENERATION_RE.fullmatch(checkpoint):
        raise ValueError(f"invalid checkpoint: {checkpoint!r}")
    return backup_dir / f"hermes-home-{checkpoint}.zip"


def _profile_name(value: str) -> str:
    if not GENERATION_RE.fullmatch(value):
        raise argparse.ArgumentTypeError(f"invalid profile name: {value!r}")
    return value


def _metadata_for(archive: Path) -> Path:
    return archive.with_suffix(".json")


def _verify_archive(
    archive: Path,
    required_profiles: tuple[str, ...],
    *,
    full_crc: bool = False,
) -> dict[str, object]:
    if not zipfile.is_zipfile(archive):
        raise RuntimeError(f"not a ZIP archive: {archive}")
    with zipfile.ZipFile(archive) as backup:
        names = {name.rstrip("/") for name in backup.namelist()}
        if full_crc:
            bad_member = backup.testzip()
            if bad_member is not None:
                raise RuntimeError(f"CRC verification failed at {bad_member}")

    missing_shared = [name for name in REQUIRED_SHARED if name not in names]
    missing_profiles = [
        profile
        for profile in required_profiles
        if not any(name.startswith(f"profiles/{profile}/") for name in names)
    ]
    if missing_shared or missing_profiles:
        raise RuntimeError(
            "backup is incomplete: "
            f"missing shared={missing_shared!r}, profiles={missing_profiles!r}"
        )
    return {
        "archive": str(archive),
        "bytes": archive.stat().st_size,
        "members": len(names),
        "required_profiles": list(required_profiles),
        "required_shared": list(REQUIRED_SHARED),
    }


def _atomic_json(path: Path, payload: dict[str, object], *, replace: bool = True) -> None:
    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            json.dump(payload, output, indent=2, sort_keys=True)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        if replace:
            os.replace(temporary, path)
        else:
            os.link(temporary, path)
            temporary.unlink()
        _sync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def _sync_directory(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open('rb') as source:
        for block in iter(lambda: source.read(1024 * 1024), b''):
            digest.update(block)
    return digest.hexdigest()


def _local_stage(path: Path, backup_dir: Path) -> Path:
    path = path.resolve()
    final_root = Path('/nest/backup').resolve()
    if path == backup_dir or backup_dir in path.parents or path == final_root or final_root in path.parents:
        raise ValueError('stage directory must be local and outside final backup storage')
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Check bind mounts too: path spelling alone does not prove local storage.
    filesystem = subprocess.run(
        ['findmnt', '--noheadings', '--output', 'FSTYPE', '--target', str(path)],
        check=True, capture_output=True, text=True,
    ).stdout.strip()
    if filesystem not in {'zfs', 'ext4', 'xfs', 'btrfs', 'tmpfs', 'overlay'}:
        raise ValueError(f'stage directory must use a known local filesystem, got {filesystem!r}')
    return path


def _publish_archive(staged: Path, archive: Path, expected_sha256: str) -> None:
    # Only verified bytes are transferred to final storage, never capture scratch.
    # Link publishes without replacing an existing checkpoint, metadata is last.
    fd, name = tempfile.mkstemp(prefix=f'.{archive.name}.', suffix='.transfer', dir=archive.parent)
    transfer = Path(name)
    try:
        with os.fdopen(fd, 'wb') as destination, staged.open('rb') as source:
            shutil.copyfileobj(source, destination, 1024 * 1024)
            destination.flush()
            os.fsync(destination.fileno())
        if _sha256(transfer) != expected_sha256:
            raise RuntimeError('final archive transfer digest mismatch')
        os.link(transfer, archive)
        _sync_directory(archive.parent)
    finally:
        transfer.unlink(missing_ok=True)


def _generation_archives(backup_dir: Path) -> list[Path]:
    archives = [
        path
        for path in backup_dir.iterdir()
        if path.is_file() and ARCHIVE_RE.fullmatch(path.name)
    ]
    return sorted(archives, key=lambda path: (path.stat().st_mtime_ns, path.name), reverse=True)


def _prune(backup_dir: Path, retain: int, protect: Path | None = None) -> list[str]:
    if retain < 1:
        raise ValueError("retain must be at least 1")
    archives = _generation_archives(backup_dir)
    # Validate every hold before deleting anything. A damaged or dangling hold
    # is an operator-visible refusal, never permission to prune its generation.
    keep = set(archives[:retain]) | _held_archives(backup_dir)
    if protect is not None:
        keep.add(protect)
    removed: list[str] = []
    for archive in archives:
        if archive in keep:
            continue
        metadata = _metadata_for(archive)
        archive.unlink()
        metadata.unlink(missing_ok=True)
        removed.append(str(archive))
    return removed


def _current_checkpoint() -> str:
    return time.strftime("cron-%Y%m%dT%H", time.gmtime())


def _read_completed_metadata(archive: Path, checkpoint: str) -> dict[str, object] | None:
    metadata_path = _metadata_for(archive)
    try:
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return None
    if not isinstance(metadata, dict) or metadata.get("checkpoint") != checkpoint or metadata.get("archive") != archive.name:
        return None
    try:
        if metadata.get("bytes") != archive.stat().st_size:
            return None
    except FileNotFoundError:
        return None
    return metadata


def create_generation(args: argparse.Namespace) -> dict[str, object]:
    if args.retain < 1:
        raise ValueError('retain must be at least 1')
    backup_dir = args.backup_dir.resolve()
    backup_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(backup_dir, 0o700)
    checkpoint = args.checkpoint or _current_checkpoint()
    archive = _archive_for(backup_dir, checkpoint)
    lock_path = backup_dir / ".generation.lock"

    with lock_path.open("a+b") as lock:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        completed = _read_completed_metadata(archive, checkpoint)
        if completed is not None:
            _verify_archive(archive, tuple(args.required_profile))
            if completed.get('sha256') and _sha256(archive) != completed['sha256']:
                raise RuntimeError('completed generation digest mismatch')
            return {"action": "reused", **completed}
        if archive.exists() or _metadata_for(archive).exists():
            raise RuntimeError(
                f"refusing to replace incomplete generation artifacts for {checkpoint}: {archive}"
            )

        stage_dir = _local_stage(args.stage_dir, backup_dir)
        with tempfile.TemporaryDirectory(prefix='hermes-generation-', dir=stage_dir) as temporary:
            staged = Path(temporary) / archive.name
            subprocess.run(
                [str(args.hermes_bin), "backup", "--output", str(staged)],
                check=True,
                stdout=sys.stderr,
                env={**os.environ, 'TMPDIR': temporary},
            )
            os.chmod(staged, 0o600)
            verification = _verify_archive(staged, tuple(args.required_profile), full_crc=True)
            digest = _sha256(staged)
            _publish_archive(staged, archive, digest)
        metadata: dict[str, object] = {
            "archive": archive.name,
            "bytes": verification["bytes"],
            "checkpoint": checkpoint,
            "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "format": "full-hermes-home-v1",
            "members": verification["members"],
            "required_profiles": verification["required_profiles"],
            "required_shared": verification["required_shared"],
            "verified": True,
            "sha256": digest,
            "verified_by": "local full CRC, SHA256 transfer readback and atomic publication",
        }
        _atomic_json(_metadata_for(archive), metadata)
        if _read_completed_metadata(archive, checkpoint) != metadata:
            raise RuntimeError('published generation receipt readback mismatch')
        removed = [] if args.no_prune else _prune(backup_dir, args.retain, protect=archive)
        return {"action": "created", **metadata, "pruned": removed}


def prune_generations(args: argparse.Namespace) -> dict[str, object]:
    backup_dir = args.backup_dir.resolve()
    backup_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (backup_dir / ".generation.lock").open("a+b") as lock:
        os.chmod(lock.name, 0o600)
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        return {"action": "pruned", "removed": _prune(backup_dir, args.retain)}


def _verification_paths(args: argparse.Namespace, *, require_age: bool = True) -> tuple[Path, tuple[Path, ...]]:
    if require_age and not 1 <= args.max_age_seconds <= 604800:
        raise ValueError('max age must be between 1 and 604800 seconds')
    if not re.fullmatch(r'[0-9a-f]{64}', args.expected_sha256):
        raise ValueError('expected SHA256 must be an exact lowercase digest')
    backup_dir = args.backup_dir.resolve(strict=True)
    directory = backup_dir.stat()
    if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != os.geteuid() or stat.S_IMODE(directory.st_mode) & 0o077:
        raise RuntimeError('generation directory must be private and owned by the backup account')
    archive = _archive_for(backup_dir, args.checkpoint)
    paths = (backup_dir / '.generation.lock', archive, _metadata_for(archive))
    # Verification must not initialize a missing lock, follow leaf symlinks or
    # silently repair private permissions. Parent directory trust is supplied by
    # the ordinary backup account and inventory, not this local receipt.
    for path in paths:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) & 0o077:
            raise RuntimeError('generation files must be private regular files owned by the backup account')
    return backup_dir, paths


def verify_generation(args: argparse.Namespace) -> dict[str, object]:
    """Read an exact published generation under the existing retention lock."""
    _backup_dir, paths = _verification_paths(args)
    with paths[0].open('rb') as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_SH | fcntl.LOCK_NB)
        return _verify_generation_locked(args, paths[1])


def _verify_generation_locked(args: argparse.Namespace, archive: Path) -> dict[str, object]:
    # Caller owns the existing generation lock throughout verification and,
    # for hold creation, through atomic publication and readback.
    metadata = _read_completed_metadata(archive, args.checkpoint)
    if not isinstance(metadata, dict) or metadata.get('format') != 'full-hermes-home-v1' or metadata.get('verified') is not True:
        raise RuntimeError('missing completed full-home generation receipt')
    if metadata.get('sha256') != args.expected_sha256:
        raise RuntimeError('generation receipt does not match the expected SHA256')
    created_text = metadata.get('created_at')
    if not isinstance(created_text, str) or not re.fullmatch(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z', created_text):
        raise ValueError('generation receipt requires a strict UTC publication timestamp')
    created = datetime.strptime(created_text, '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc)
    verification = _verify_archive(archive, tuple(args.required_profile))
    if any(type(metadata.get(key)) is not int or metadata[key] != verification[key] for key in ('bytes', 'members')):
        raise RuntimeError('generation receipt counts do not match the archive')
    profiles = metadata.get('required_profiles')
    if not isinstance(profiles, list) or not all(isinstance(profile, str) for profile in profiles):
        raise RuntimeError('generation receipt requires a profile list')
    if metadata.get('required_shared') != list(REQUIRED_SHARED) or not set(args.required_profile) <= set(profiles):
        raise RuntimeError('generation receipt does not cover the required shared state and profiles')
    if _sha256(archive) != args.expected_sha256:
        raise RuntimeError('generation archive digest mismatch')
    # Hashing can take time. Evaluate freshness after the complete readback,
    # never use a pre-hash sample as an admission lease.
    checked = datetime.now(timezone.utc)
    age = (checked - created).total_seconds()
    if not 0 <= age <= args.max_age_seconds:
        raise RuntimeError('generation publication is future-dated or older than the required limit')
    if _read_completed_metadata(archive, args.checkpoint) != metadata:
        raise RuntimeError('generation receipt changed during verification')
    return {
        'schema': 1, 'kind': 'nest_hermes_generation_verification', 'action': 'verified',
        'checkpoint': args.checkpoint, 'sha256': args.expected_sha256,
        'archive': archive.name, 'bytes': verification['bytes'], 'members': verification['members'],
        'required_profiles': list(args.required_profile), 'created_at': created_text,
        'checked_at': checked.strftime('%Y-%m-%dT%H:%M:%SZ'), 'max_age_seconds': args.max_age_seconds,
        'restore_verified': False, 'execution_authorized': False,
    }


def _unique_fields(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError('duplicate hold field')
        result[key] = value
    return result


def _hold_path(backup_dir: Path, hold_id: str) -> Path:
    if not isinstance(hold_id, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,63}', hold_id):
        raise ValueError('invalid retention hold ID')
    return backup_dir / f'.generation-hold-{hold_id}.json'


def _read_hold(path: Path) -> dict[str, object]:
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, 'rb') as source:
        info = path.lstat()
        opened = os.fstat(source.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or
                stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1 or
                (info.st_dev, info.st_ino) != (opened.st_dev, opened.st_ino)):
            raise RuntimeError('retention hold must be a private single-link regular file')
        raw = source.read(16385)
        if len(raw) > 16384:
            raise ValueError('retention hold exceeds size bound')
        after = os.fstat(source.fileno())
        if (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns) != (
                opened.st_dev, opened.st_ino, opened.st_size, opened.st_mtime_ns, opened.st_ctime_ns):
            raise RuntimeError('retention hold changed while reading')
    hold = json.loads(raw, object_pairs_hook=_unique_fields)
    if (not isinstance(hold, dict) or set(hold) != HOLD_FIELDS or type(hold['schema']) is not int or
            hold['schema'] != 1 or hold['kind'] != 'nest_hermes_generation_hold' or
            _hold_path(path.parent, hold['hold_id']) != path or
            not isinstance(hold['release'], str) or not re.fullmatch(r'sha256:[0-9a-f]{64}', hold['release']) or
            not isinstance(hold['sha256'], str) or not re.fullmatch(r'[0-9a-f]{64}', hold['sha256'])):
        raise ValueError('invalid retention hold identity')
    if not isinstance(hold['checkpoint'], str):
        raise ValueError('invalid retention checkpoint')
    archive = _archive_for(path.parent, hold['checkpoint'])
    if hold['archive'] != archive.name or any(type(hold[key]) is not int or hold[key] <= 0 for key in ('bytes', 'members')):
        raise ValueError('invalid retention hold generation')
    profiles = hold['required_profiles']
    if (not isinstance(profiles, list) or not profiles or len(profiles) > 128 or
            any(not isinstance(profile, str) or not GENERATION_RE.fullmatch(profile) for profile in profiles) or
            len(set(profiles)) != len(profiles)):
        raise ValueError('invalid retention hold profile coverage')
    return hold


def _held_archives(backup_dir: Path) -> set[Path]:
    protected = set()
    for path in backup_dir.iterdir():
        if not path.name.startswith('.generation-hold-'):
            continue
        if not HOLD_RE.fullmatch(path.name):
            raise ValueError('unrecognized retention hold file; refusing prune')
        hold = _read_hold(path)
        archive = _archive_for(backup_dir, hold['checkpoint'])
        for member in (archive, _metadata_for(archive)):
            info = member.lstat()
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) & 0o077:
                raise RuntimeError('held generation is missing or unsafe; refusing prune')
        metadata = _read_completed_metadata(archive, hold['checkpoint'])
        if (metadata is None or metadata.get('verified') is not True or metadata.get('format') != 'full-hermes-home-v1' or
                any(metadata.get(key) != hold[key] for key in ('archive', 'checkpoint', 'sha256', 'bytes', 'members')) or
                not set(hold['required_profiles']) <= set(metadata.get('required_profiles', []))):
            raise RuntimeError('held generation receipt differs; refusing prune')
        protected.add(archive)
    return protected


def retain_generation(args: argparse.Namespace) -> dict[str, object]:
    """Persist/recheck/release one exact hold, serialized with ordinary pruning."""
    if not re.fullmatch(r'sha256:[0-9a-f]{64}', args.release):
        raise ValueError('invalid retention release digest')
    if (not 1 <= len(args.required_profile) <= 128 or len(set(args.required_profile)) != len(args.required_profile) or
            any(len(profile) > 128 for profile in args.required_profile)):
        raise ValueError('invalid retention profile coverage')
    backup_dir, paths = _verification_paths(args, require_age=args.command != 'release-hold')
    path = _hold_path(backup_dir, args.hold_id)
    shared = args.command == 'check-hold'
    # Linux NFS implements flock with byte-range locks: exclusive locks need
    # write access. Open the existing lock without creating or truncating it.
    with paths[0].open('rb' if shared else 'r+b') as lock:
        fcntl.flock(lock.fileno(), (fcntl.LOCK_SH if shared else fcntl.LOCK_EX) | fcntl.LOCK_NB)
        if args.command == 'hold':
            verified = _verify_generation_locked(args, paths[1])
            hold = {key: verified[key] for key in ('checkpoint', 'archive', 'sha256', 'bytes', 'members', 'required_profiles')}
            hold.update(schema=1, kind='nest_hermes_generation_hold', hold_id=args.hold_id, release=args.release)
            if path.exists() or path.is_symlink():
                if _read_hold(path) != hold:
                    raise RuntimeError('retention ID already binds another generation or release')
            else:
                _atomic_json(path, hold, replace=False)
            if _read_hold(path) != hold:
                raise RuntimeError('retention hold readback mismatch')
        else:
            hold = _read_hold(path)
            if (hold['release'] != args.release or hold['checkpoint'] != args.checkpoint or
                    hold['sha256'] != args.expected_sha256 or hold['required_profiles'] != args.required_profile):
                raise RuntimeError('retention hold does not match exact requested scope')
            if shared:
                verified = _verify_generation_locked(args, paths[1])
                if any(hold[key] != verified[key] for key in ('bytes', 'members', 'archive')):
                    raise RuntimeError('held generation differs')
            else:
                # Explicit release removes only this exact hold, not the archive,
                # another release's hold, or any receipt. It never invokes prune.
                path.unlink()
                _sync_directory(backup_dir)
                if path.exists() or path.is_symlink():
                    raise RuntimeError('retention hold release readback mismatch')
        result = {'schema': 1, 'kind': 'nest_hermes_generation_retention', 'action': args.command,
                  'hold': hold, 'held': args.command != 'release-hold', 'readback_verified': True,
                  'restore_verified': False, 'execution_authorized': False}
        if args.command == 'check-hold':
            # Bind freshness and archive bytes to the exact existing hold under
            # the same shared lock, without another expensive archive scan.
            result['verification'] = verified
        return result


def _cleanup_legacy_locked(args: argparse.Namespace, backup_dir: Path) -> dict[str, object]:
    legacy = sorted(
        (path for path in backup_dir.iterdir() if path.is_file() and LEGACY_RE.fullmatch(path.name)),
        key=lambda path: (path.stat().st_mtime_ns, path.name),
        reverse=True,
    )
    protected = legacy[:1]
    candidates = legacy[1:]
    report: dict[str, object] = {
        "action": "legacy-cleanup-applied" if args.apply else "legacy-cleanup-dry-run",
        "candidate_bytes": sum(path.stat().st_size for path in candidates),
        "candidates": [str(path) for path in candidates],
        "candidate_details": [
            {"bytes": path.stat().st_size, "path": str(path)} for path in candidates
        ],
        "protected_newest_legacy": [str(path) for path in protected],
        "protected_details": [
            {"bytes": path.stat().st_size, "path": str(path)} for path in protected
        ],
    }
    if not args.apply:
        return report

    generations = _generation_archives(backup_dir)
    if not generations:
        raise RuntimeError("refusing legacy cleanup without a completed full-home generation")
    newest_generation = generations[0]
    metadata = _read_completed_metadata(newest_generation, ARCHIVE_RE.fullmatch(newest_generation.name).group(1))
    if metadata is None or metadata.get("verified") is not True:
        raise RuntimeError("refusing legacy cleanup without verified generation metadata")
    _verify_archive(newest_generation, tuple(args.required_profile), full_crc=True)

    deleted: list[str] = []
    for path in candidates:
        path.unlink()
        deleted.append(str(path))
    survivors = [str(path) for path in legacy if path.exists()]
    if [str(path) for path in protected] != survivors:
        raise RuntimeError(f"legacy cleanup readback mismatch: survivors={survivors!r}")
    report["deleted"] = deleted
    report["readback_survivors"] = survivors
    report["verified_generation"] = str(newest_generation)
    return report


def cleanup_legacy(args: argparse.Namespace) -> dict[str, object]:
    backup_dir = args.backup_dir.resolve()
    backup_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (backup_dir / ".generation.lock").open("a+b") as lock:
        os.chmod(lock.name, 0o600)
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        return _cleanup_legacy_locked(args, backup_dir)


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser()
    subparsers = result.add_subparsers(dest="command", required=True)

    def common(subparser: argparse.ArgumentParser) -> None:
        subparser.add_argument("--backup-dir", type=Path, required=True)
        subparser.add_argument(
            "--required-profile",
            action="append",
            default=[],
            type=_profile_name,
        )

    backup = subparsers.add_parser("backup")
    common(backup)
    backup.add_argument("--checkpoint")
    backup.add_argument("--hermes-bin", type=Path, required=True)
    backup.add_argument("--stage-dir", type=Path, required=True)
    backup.add_argument("--no-prune", action='store_true')
    backup.add_argument("--retain", type=int, default=24)
    backup.set_defaults(handler=create_generation)

    verify = subparsers.add_parser('verify')
    common(verify)
    verify.add_argument('--checkpoint', required=True)
    verify.add_argument('--expected-sha256', required=True)
    verify.add_argument('--max-age-seconds', type=int, required=True)
    verify.set_defaults(handler=verify_generation)

    for action in ('hold', 'check-hold', 'release-hold'):
        retention = subparsers.add_parser(action)
        common(retention)
        retention.add_argument('--checkpoint', required=True)
        retention.add_argument('--expected-sha256', required=True)
        if action != 'release-hold':
            retention.add_argument('--max-age-seconds', type=int, required=True)
        retention.add_argument('--hold-id', required=True)
        retention.add_argument('--release', required=True)
        retention.set_defaults(handler=retain_generation)

    prune = subparsers.add_parser("prune")
    common(prune)
    prune.add_argument("--retain", type=int, default=24)
    prune.set_defaults(handler=prune_generations)

    legacy = subparsers.add_parser("legacy-cleanup")
    common(legacy)
    legacy.add_argument("--apply", action="store_true")
    legacy.set_defaults(handler=cleanup_legacy)
    return result


def main() -> int:
    args = parser().parse_args()
    if hasattr(args, "required_profile") and not args.required_profile:
        args.required_profile = list(DEFAULT_PROFILES)
    try:
        result = args.handler(args)
    except (OSError, RuntimeError, ValueError, UnicodeError, zipfile.BadZipFile, subprocess.CalledProcessError) as exc:
        print(json.dumps({"error": str(exc)}, sort_keys=True), file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
