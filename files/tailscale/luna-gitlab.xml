<?xml version="1.0" encoding="utf-8"?>
<policy target="DROP" priority="-100">
  <short>Luna GitLab SSH and isolated Joyride TEST HTTPS</short>
  <ingress-zone name="luna"/>
  <!-- Destination source-zone classification precedes the br0 interface zone. -->
  <egress-zone name="internal"/>
  <rule family="ipv4">
    <source address="100.127.2.74/32"/>
    <destination address="172.21.2.1/32"/>
    <port port="22" protocol="tcp"/>
    <accept/>
  </rule>
  <rule family="ipv4">
    <source address="100.127.2.74/32"/>
    <destination address="172.21.2.1/32"/>
    <masquerade/>
  </rule>
  <rule family="ipv4">
    <source address="100.127.2.74/32"/>
    <destination address="172.21.1.3/32"/>
    <port port="443" protocol="tcp"/>
    <accept/>
  </rule>
  <rule family="ipv4">
    <source address="100.127.2.74/32"/>
    <destination address="172.21.1.3/32"/>
    <masquerade/>
  </rule>
  <rule family="ipv4">
    <source address="100.127.2.74/32"/>
    <destination address="172.21.0.3/32"/>
    <port port="443" protocol="tcp"/>
    <accept/>
  </rule>
  <rule family="ipv4">
    <source address="100.127.2.74/32"/>
    <destination address="172.21.0.3/32"/>
    <masquerade/>
  </rule>
</policy>
